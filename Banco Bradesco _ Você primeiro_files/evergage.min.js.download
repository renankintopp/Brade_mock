const getEventFromDataLayerRevert = (eventName) => {
    if (window.dataLayer) {
        for (let i = window.dataLayer.length - 1; i >= 0; i--) {
            if (window.dataLayer[i].event == eventName) {
                dataget = window.dataLayer[i];
                return window.dataLayer[i];
            }
        }
    }
};

// ========================================
// HELPERS - USER IDENTIFICATION PARA O IB
// ========================================

function getUserId() {
  const keys = ["idSalesforce", "idSalesForce"];

  for (let key of keys) {
    let val = sessionStorage.getItem(key) || localStorage.getItem(key);

    if (val && val.trim() !== "" && val.trim().startsWith("003")) {
      return val.trim();
    }
  }
  return null;
}

function waitForUserId(callback, retries = 10, interval = 1000) {
  let attempts = 0;

  const timer = setInterval(() => {
    const id = getUserId();

    if (id) {
      clearInterval(timer);
      console.log("[Evergage] ID encontrado:", id);
      callback(id);
    } else {
      attempts++;
      console.log("[Evergage] aguardando ID... tentativa", attempts);

      if (attempts >= retries) {
        clearInterval(timer);
        console.log("[Evergage] ID não encontrado após tentativas");
      }
    }
  }, interval);
}

function isTestUser() {
    return getUserId() === "";
}

// NOVA FUNÇÃO SPA
let lastUrl = window.location.href;

function observeRouteChange() {
  setInterval(() => {
    if (lastUrl !== window.location.href) {

      lastUrl = window.location.href;

      console.log("[Evergage] SPA route change detectado");

      if (getUserId()) {
        Evergage.reinit();
      } else {
        console.log("[Evergage] aguardando ID antes de reinit");
      }
    }
  }, 1000);
}

function sendLoginAction(containerSelector) {

    let agencia = Evergage.cashDom(containerSelector + " #AGN").val();
    let contaCorrente = Evergage.cashDom(containerSelector + " #CTA").val();
    let digitoContaCorrente = Evergage.cashDom(containerSelector + " #DIGCTA").val();

    agencia = agencia.replace(/\D/g, '');
    contaCorrente = contaCorrente.replace(/\D/g, '')
    digitoContaCorrente = digitoContaCorrente.replace(/\D/g, '')

    if (agencia && contaCorrente && digitoContaCorrente) {

        agencia = agencia.trim().padStart(6, "0");
        contaCorrente = contaCorrente.trim().padStart(7, "0");

        const evg_financialaccountkey = "237_" + agencia + "_" + contaCorrente;

        Evergage.sendEvent({
            action: TIPO_ATIVIDADE.internetBanking.login,
            user: {
                id: evg_financialaccountkey
            }
        });
    }
}

function generateRandomOrderIdMobile() {
    const idSalesforce = sessionStorage.getItem("idSalesforce") || sessionStorage.getItem("idSalesforce");
    return idSalesforce ? idSalesforce + Date.now() : Math.ceil(Math.random() * 10000000000000).toString() + Date.now()
}

function generateRandomOrderIdIB() {
    var idSalesforce = null;
    if (localStorage.getItem("idSalesforce")) {
        idSalesforce = localStorage.getItem("idSalesforce");
    } else if (localStorage.getItem("idSalesForce")) {
        idSalesforce = localStorage.getItem("idSalesForce");
    }

    return idSalesforce ? idSalesforce + Date.now() : Math.ceil(Math.random() * 10000000000000).toString() + Date.now()
}

function findCardByTitle(cards, text) {
    const selectedCards = cards.filter((index, card) => {
        const header = card.querySelector("h4");
        return !!header && header.innerText === text;
    })
    return selectedCards.length > 0 ? selectedCards[0] : null;
}

function findInvestmentCardsByTitle(text) {
    const cards = Evergage.cashDom(".card-investimento__conteudo");
    return findCardByTitle(cards, text);
}

function findInDataLayer(targetAttribute) {
    const dl = window.dataLayer;
    if (!Array.isArray(dl) || !targetAttribute) return;

    const getByPath = (obj, path) =>
        path.split(".").reduce((acc, key) => (acc && acc[key] != null ? acc[key] : undefined), obj);

    for (let i = 0; i < dl.length; i++) {
        const obj = dl[i];
        if (obj && typeof obj === "object") {
            const val = getByPath(obj, targetAttribute);
            if (val != null && !(typeof val === "string" && val.trim() === "")) {
                return obj;
            }
        }
    }
    return;
}


/**
 * Retorna o melhor candidato para checagem de "privado".
 * Prioridades:
 *   1) ep_padrao.screen_name
 *   2) ep_padrao.nome_elemento
 *   3) screen_name (raiz)    [fallback]
 *   4) nome_elemento (raiz)  [fallback]
 *
 * Observação: apesar do nome sugerir só "screen_name",
 * este helper retorna também nome_elemento quando necessário.
 */
function getScreenNameFromDataLayer() {
    const dl = Array.isArray(window?.dataLayer) ? window.dataLayer : null;
    if (!dl || dl.length === 0) return null;

    // util para obter "a.b.c" com segurança
    const getByPath = (obj, path) =>
        path.split('.').reduce((acc, k) => (acc && acc[k] != null ? acc[k] : undefined), obj);

    for (let i = dl.length - 1; i >= 0; i--) {
            const item = dl[i];
            if (!item || typeof item !== 'object') continue;

            // ep_padrao pode vir como objeto ou como string JSON
            let ep = item.ep_padrao;
            if (typeof ep === 'string') {
            try { ep = JSON.parse(ep); } catch { /* silencioso */ }
            }

            const readable = { ...item, ep_padrao: ep || item.ep_padrao };

            // 1) ep_padrao.screen_name
            const sn = getByPath(readable, 'ep_padrao.screen_name');
            if (typeof sn === 'string' && sn.trim()) return sn.trim();

            // 2) ep_padrao.nome_elemento
            const ne = getByPath(readable, 'ep_padrao.nome_elemento');
            if (typeof ne === 'string' && ne.trim()) return ne.trim();

            // 3) screen_name (raiz) - fallback
            const snRoot = readable?.screen_name;
            if (typeof snRoot === 'string' && snRoot.trim()) return snRoot.trim();

            // 4) nome_elemento (raiz) - fallback
            const neRoot = readable?.nome_elemento;
            if (typeof neRoot === 'string' && neRoot.trim()) return neRoot.trim();
    }

    return null;
}


//
// Busca recursivamente qualquer screen_name no dataLayer
//
function findScreenNameInDataLayer() {
    const dl = window.dataLayer;
    if (!Array.isArray(dl)) return;

    const searchScreenName = (obj) => {
        if (obj && typeof obj === "object") {
            if (obj.screen_name && obj.screen_name.trim() !== "") {
                return obj.screen_name;
            }
            for (const key in obj) {
                const result = searchScreenName(obj[key]);
                if (result) return result;
            }
        }
        return null;
    };

    for (let i = dl.length - 1; i >= 0; i--) {
        const result = searchScreenName(dl[i]);
        if (result) return result;
    }
    return null;
}

//
//Verifica se o modal NPS está presente no DOM
///
function isModalNPSPresent() {
    const modal = document.querySelector("#modalSpace.showModal");
    const titulo = document.querySelector("#tituloPrimeiroModal")?.textContent || "";
    return modal !== null && titulo.includes("Conta pra gente o que achou");
}

//
//Verifica se o screen_name atual é igual ao esperado
///
function isScreenNameMatch(expected) {
    const screenName = findScreenNameInDataLayer();
    return screenName === expected;
}

// Função captura elementos Datalayer do FIM para o INICIO (Dados atuais add)
//** implementado em 13/11/2025
// * Igual à anterior, mas percorre de trás para frente para pegar o push MAIS RECENTE.
// * Mantém o MESMO nome e assinatura original.
// */

function findInDataLayerRevert(targetAttribute) {
    const dl = window.dataLayer;
    if (!Array.isArray(dl) || !targetAttribute) return;

    const getByPath = (obj, path) =>
        path.split(".").reduce((acc, key) => (acc && acc[key] != null ? acc[key] : undefined), obj);

    for (let i = dl.length - 1; i >= 0; i--) {
        const obj = dl[i];
        if (obj && typeof obj === "object") {
            const val = getByPath(obj, targetAttribute);
            if (val != null && !(typeof val === "string" && val.trim() === "")) {
                return obj;
            }
        }
    }
    return null;
}

// ----------------------------------------------------
// Helper - getScreenNameSafeExact para Consignado
// Estratégia: retorna o último screen_name que atende uma regra
// Objetivo: evitar uso do último push (DL instável em SPA)
// UPDATE: 25/06/2026
// ----------------------------------------------------
function getScreenNameSafeExact(matchFn) {
    try {

        var dl = window.dataLayer;

        if (!Array.isArray(dl)) return null;

        // varre do mais recente para o mais antigo
        for (var i = dl.length - 1; i >= 0; i--) {

            var item = dl[i];

            if (!item || item.event !== "Screen_Data") continue;

            var screen = item?.ep_padrao?.screen_name;

            if (typeof screen !== "string") continue;

            var normalized = screen.replace(/\/+$/, "").toLowerCase();

            if (matchFn(normalized)) {
                return normalized;
            }
        }

        return null;

    } catch (e) {
        return null;
    }
}

//**
// * Função: getDataLayerValueSmart
// *
// * Objetivo:
// * Percorrer o DataLayer, filtrar eventos de um tipo específico (ex: Screen_Data),
// * e retornar o valor mais relevante, priorizando sempre o último evento.
//  *
//  * Parâmetros:
//  * - dataLayer: array global de eventos do DataLayer (window.dataLayer)
//  * - eventName: nome do evento a ser filtrado (ex: "Screen_Data")
//  * - propertyPath: caminho da propriedade dentro do objeto (ex: "ep_padrao.screen_name")
//  * - comparator: função opcional para validar qual valor deve ser retornado
//  *
//  * Retorno:
//  * - valor encontrado no DataLayer (string ou outro tipo) ou undefined
//  *
function getDataLayerValueSmart(dataLayer, eventName, propertyPath, comparator) {

  // 1. Valida se o DataLayer informado é realmente um array
  // Caso não seja, não é possível processar → retorna undefined
  if (!Array.isArray(dataLayer)) return undefined;

  // 2. Converte o caminho da propriedade em um array de chaves
  // Ex: "ep_padrao.screen_name" → ["ep_padrao", "screen_name"]
  const path = propertyPath.split('.');

  // 3. Percorre o DataLayer para extrair os valores desejados
  const values = dataLayer

    // 3.1 Filtra apenas os objetos válidos e com o evento correto
    .filter(item => item && item.event === eventName)

    // 3.2 Para cada evento, extrai dinamicamente a propriedade desejada
    // Usa reduce para navegar em objetos aninhados sem erro
    .map(item =>
      path.reduce(
        (acc, key) =>
          (acc && acc[key] !== undefined ? acc[key] : undefined),
        item
      )
    )

    // 3.3 Remove valores indefinidos (casos onde o path não existe)
    .filter(v => v !== undefined);

  // 4. Se nenhum valor foi encontrado, retorna undefined
  if (values.length === 0) return undefined;

  // 5. Obtém o último valor da lista
  // Representa o evento mais recente dentro do filtro aplicado
  const lastValue = values[values.length - 1];

  /**
   * 6. Verifica se todos os valores encontrados são iguais
   * Isso pode ocorrer quando o mesmo screen_name é disparado várias vezes
   */
  const allEqual = values.every(v => v === values[0]);

  if (allEqual) {
    // Se todos são iguais, retornar o último mantém consistência
    return lastValue;
  }

  /**
   * 7. Caso exista mais de um valor diferente:
   * Se foi informado um comparator (função de validação),
   * percorre os valores do final para o início (mais recente → mais antigo)
   */
  if (typeof comparator === 'function') {

    for (let i = values.length - 1; i >= 0; i--) {

      // Se algum valor atender à condição definida no comparator, retorna ele
      if (comparator(values[i])) {
        return values[i];
      }
    }

    // Se nenhum valor atender ao comparator, retorna undefined
    return undefined;
  }

  /**
   * 8. Caso não exista comparator:
   * Retorna o último valor encontrado como fallback
   */
  return lastValue;
}

/**
 * waitForDataLayerMatch COM cancelamento por mudança de rota
 * UPDATE: 19/06/2026
 */
function waitForDataLayerMatch({
    paths,
    eventName = "Screen_Data",
    propertyPath = "ep_padrao.screen_name",
    maxAttempts = 8,
    interval = 250
}) {

    var pathInicial = window.location && window.location.pathname;

    var pathKeys = propertyPath.split(".");

    function getValue(obj) {
        var acc = obj;
        for (var i = 0; i < pathKeys.length; i++) {
            if (!acc) return null;
            acc = acc[pathKeys[i]];
        }
        return acc;
    }

    return new Promise(function (resolve) {

        var attempts = 0;

        var timer = setInterval(function () {

            ////////////////////////////////////////////////////
            // CANCELAMENTO: mudou de tela → PARA TUDO
            ////////////////////////////////////////////////////
            var pathAtual = window.location && window.location.pathname;

            if (pathAtual !== pathInicial) {
                clearInterval(timer);
                resolve(null);
                return;
            }

            ////////////////////////////////////////////////////
            // DL
            ////////////////////////////////////////////////////
            var dl = window.dataLayer;

            if (Array.isArray(dl)) {

                for (var i = dl.length - 1; i >= 0; i--) {

                    var item = dl[i];

                    if (!item || item.event !== eventName) continue;

                    var value = getValue(item);

                    if (typeof value === "string") {
                        value = value.replace(/\/+$/, "").toLowerCase();
                    }

                    if (value && paths.indexOf(value) !== -1) {
                        clearInterval(timer);
                        resolve(value);
                        return;
                    }
                }
            }

            attempts++;

            if (attempts >= maxAttempts) {
                clearInterval(timer);
                resolve(null);
            }

        }, interval);
    });
}

//=============================================
//Helper focado em EXTRAÇÃO (não em decisão)
//Ele só pega valores — NÃO decide match
//=============================================
function getDataLayerValuesBySourcePriority(dataLayer) {
    if (!Array.isArray(dataLayer)) return [];

    const fromNovo = [];
    const fromAntigo = [];

    for (const item of dataLayer) {
        if (!item || typeof item !== "object") continue;

        // Prioridade: Screen_Data_Novo
        if (item.event === "Screen_Data_Novo") {
            if (item.screen?.path) {
                fromNovo.push(item.screen.path);
            }
            if (item.ep_padrao?.screen_name) {
                fromNovo.push(item.ep_padrao.screen_name);
            }
        }

        // Fallback: Screen_Data
        if (item.event === "Screen_Data") {
            if (item.screen?.path) {
                fromAntigo.push(item.screen.path);
            }
            if (item.ep_padrao?.screen_name) {
                fromAntigo.push(item.ep_padrao.screen_name);
            }
        }
    }

    // Regra de prioridade
    return fromNovo.length > 0 ? fromNovo : fromAntigo;
}

// ====================================================================
// CARTÕES - HELPERS DE ROTEAMENTO DINÂMICO POR URL/HREF (+ DL opcional)
// Minimalistas, sem optional chaining, com try/catch
// ====================================================================

/**
 * Normaliza string com segurança.
 * - Evita exceptions; sempre retorna string trimada.
 */
function _norm(v) {
    try { return (v == null ? "" : String(v)).trim(); } catch (e) { return ""; }
}

/**
 * Pathname seguro.
 * - Retorna window.location.pathname ou "".
 */
function _path() {
    try { return typeof window.location.pathname === "string" ? window.location.pathname : ""; } catch (e) { return ""; }
}

/**
 * Href seguro.
 * - Retorna window.location.href ou "".
 */
function _href() {
    try { return typeof window.location.href === "string" ? window.location.href : ""; } catch (e) { return ""; }
}

/**
 * Testa regex com segurança.
 * - Retorna false se a regex ou a string causarem erro.
 */
function _test(re, s) {
    try { return re.test(s); } catch (e) { return false; }
}

/**
 * Aguarda seletor existir (sem ler texto ou acessar [0].innerText).
 * - Para telas SPA que montam o DOM depois da rota.
 * - Retorna Promise<boolean>.
 */
function waitForSelector(selector) {
    try {
        return Evergage.DisplayUtils.pageElementLoaded(selector, "html").then(function () { return true; });
    } catch (e) {
        return Promise.resolve(false);
    }
}

// Helper - getScreenNameFromDL_Cartoes
//
// Estratégia:
// 1. Prioriza screen.path (novo LEAP)
// 2. Fallback para ep_padrao.screen_name
// 3. Fallback para screen_name legado
// 4. Busca do mais recente para o mais antigo
//
// Objetivo:
// Suportar simultaneamente os fluxos
// antigos e novos de Cartões.
//
// UPDATE: 10/08/2026
// ----------------------------------------------------
function getScreenNameFromDL_Cartoes() {
    try {
        var dl = Array.isArray(window.dataLayer)
            ? window.dataLayer
            : [];
        for (var i = dl.length - 1; i >= 0; i--) {
            var it = dl[i];
            if (!it || typeof it !== "object") {
                continue;
            }
            ////////////////////////////////////////////////////
            // NOVO PADRÃO (LEAP)
            ////////////////////////////////////////////////////
            if (
                it.screen &&
                typeof it.screen.path === "string"
            ) {
                return it.screen.path
                    .trim()
                    .toLowerCase();
            }
            ////////////////////////////////////////////////////
            // PADRÃO ATUAL MOBILE
            ////////////////////////////////////////////////////
            if (
                it.ep_padrao &&
                typeof it.ep_padrao.screen_name === "string"
            ) {

                return it.ep_padrao.screen_name
                    .trim()
                    .toLowerCase();
            }
            ////////////////////////////////////////////////////
            // LEGADO
            ////////////////////////////////////////////////////
            if (
                typeof it.screen_name === "string"
            ) {
                return it.screen_name
                    .trim()
                    .toLowerCase();
            }
        }
        return null;
    } catch (e) {
        return null;
    }
}

// --------------------------------------------------------------------
// Padrões de rotas: URL/HREF/DL -> "estágio"
// - Cada entrada tem uma chave `key` (ex.: "desbloqueio:efetivacao")
// - `type` define onde casa: "url" (pathname), "href" (href), "dl" (screen_name)
// - `re` é a regex para casar a rota.
// Observação: RX_JSESS_QH tolera ;jsessionid, ?query e #hash.
// --------------------------------------------------------------------

/** Tolerância a ;jsessionid, ?query, #hash */
var RX_JSESS_QH = "(?:;[^?#]*)?(?:[?#].*)?$";

/**
 * Padrões de URL/href/DL -> estágio
 * - Inclui rotas principais do seu sitemap: Desbloqueio, Cancelamento, Novo, Aceite digital, Fatura, Adicional, Extrato CC.
 * - Você pode acrescentar novos itens facilmente (veja o mini-guia).
 */
var URL_PATTERNS = [
    // ---------------------------
    // DESBLOQUEIO LEAP (NOVO)
    // ---------------------------
    { key: "desbloqueio:conhecimento",    type: "dl", re: /^desbloqueio-leap\/seu-cartao-chegou$/ },
    { key: "desbloqueio:simulacao",       type: "dl", re: /^desbloqueio-leap\/agora-e-so-confirmar/ },
    { key: "desbloqueio:efetivacao_sem_seguro",   type: "dl", re: /^desbloqueio-leap\/cartao-desbloqueado.*sem-seguro$/ },
    { key: "desbloqueio:efetivacao_com_seguro",   type: "dl", re: /^desbloqueio-leap\/cartao-desbloqueado.*com-seguro$/ },
    // ---------------------------
    // DESBLOQUEIO
    // ---------------------------
    { key: "desbloqueio:conhecimento", type: "url",  re: new RegExp("/bcpf_cartao/(android|ios|iphone)/CartaoCreditoDesbloqueioCartaoEntradaDados\\.do" + RX_JSESS_QH) },
    { key: "desbloqueio:simulacao",    type: "url",  re: new RegExp("/bcpf_cartao/(android|ios|iphone)/CartaoCreditoDesbloqueioCartaoConfirmacao\\.do"   + RX_JSESS_QH) },
    { key: "desbloqueio:efetivacao",   type: "url",  re: new RegExp("/bcpf_cartao/(android|ios|iphone)/TkTcValidacao\\.do"                              + RX_JSESS_QH) },

    // ---------------------------
    // CANCELAMENTO
    // ---------------------------
    { key: "cancelamento:conhecimento", type: "url", re: /\/bcpf_cartoes_solicitacaodecartao\/cartoes_cancelamento_2_0/ },
    { key: "cancelamento:simulacao",    type: "url", re: /\/bcpf_cartoes_solicitacaodecartao\/cartoes_cancelamento_3_0/ },
    { key: "cancelamento:chave",        type: "url", re: /\/bcpf_cartoes_solicitacaodecartao\/chaveSeguranca$/ },

    // ---------------------------
    // CARTÕES (NOVO) via Data Layer (ep_padrao.screen_name)
    // ---------------------------
    { key: "novo:interesse",          type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/carrossel_cartao$/ },
    { key: "novo:personalizar",       type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/personalizar_cartao$/ },
    { key: "novo:completarCadastro",  type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/completar_cadastro$/ },
    { key: "novo:endereco",           type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/endereco$/ },
    { key: "novo:resumo",             type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/resumo$/ },
    { key: "novo:aprovado_dzero_aprovado",     type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/sucesso_cartao_aprovado_dzero_aprovado$/ },
    { key: "novo:aprovado_dzero_sem_emissao",  type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/sucesso_cartao_aprovado_dzero_sem_emissao_online$/ },
    { key: "novo:aprovado_dzero_nao_elegivel", type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/sucesso_cartao_aprovado_dzero_nao_elegivel$/ },
    { key: "novo:pedido_em_analise",           type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/sucesso_cartao_em_analise$/ },
    { key: "novo:proposta_recusada",           type: "dl", re: /^apppf\/cartoes\/solicitacao_cartao\/proposta_recusada$/ },

    // ---------------------------
    // ACEITE DIGITAL (href com fragment)
    // ---------------------------
    { key: "aceiteDigital:resumo",    type: "href", re: /front_apl\/bcpf\-fed\-aceite\-digital\-cartoes\/#\/resumo\-proposta/ },
    { key: "aceiteDigital:conclusao", type: "href", re: /front_apl\/bcpf\-fed\-aceite\-digital\-cartoes\/#\/conclusao/ },

    // ---------------------------
    // FATURA (parcelamento, etc.)
    // ---------------------------
    { key: "fatura:pagamento",            type: "url", re: /front_apl\/bcpf\-fed\-pagamento\-fatura\/pagamento\-fatura/ },
    { key: "fatura:parcelar:sugestao",    type: "url", re: /front_apl\/bcpf\-fed\-parcelamento\-fatura\/sugestao\-parcelamento/ },
    { key: "fatura:parcelar:detalhe",     type: "url", re: /front_apl\/bcpf\-fed\-parcelamento\-fatura\/detalhe\-parcelamento/ },
    { key: "fatura:parcelar:conclusao",   type: "url", re: /front_apl\/bcpf\-fed\-parcelamento\-fatura\/conclusao\-boleto/ },
    { key: "fatura:parcelar:novaSim",     type: "url", re: /front_apl\/bcpf\-fed\-parcelamento\-fatura\/nova\-simulacao/ },

    // ---------------------------
    // CARTÃO ADICIONAL / EXTRATO CC
    // ---------------------------
    { key: "adicional:sucesso",   type: "url", re: /front_apl\/bcpf\-fed\-cartao\-adicional\/conclusao\-solicitacao/ },
    { key: "adicional:erroSist",  type: "url", re: /front_apl\/bcpf\-fed\-cartao\-adicional\/error\/erro\-sistemico/ },
    { key: "extratoCC",           type: "url", re: /\/VisualizaExtratoCC\.do/ },
];

/**
 * Resolve estágio a partir de URL/href (+ DL opcional)
 * - Percorre URL_PATTERNS e retorna a `key` do primeiro padrão que casa.
 * - Ordem: primeiro URL/href, depois DL (quando você habilitar).
 */
function getCartoesStage() {
    try {
        var p = _path();
        var h = _href();

        // 1) URL/href
        for (var i = 0; i < URL_PATTERNS.length; i++) {
            var pat = URL_PATTERNS[i];
            if (pat.type === "url"  && _test(pat.re, p)) return pat.key;
            if (pat.type === "href" && _test(pat.re, h)) return pat.key;
        }

        // 2) Data Layer (opcional; pronto para uso futuro)
        var sn = getScreenNameFromDL_Cartoes();
        if (typeof sn === "string") {
            for (var j = 0; j < URL_PATTERNS.length; j++) {
                var pat2 = URL_PATTERNS[j];
                if (pat2.type === "dl" && _test(pat2.re, sn)) {
                    return pat2.key;
                }
            }
        }

        return null;
    } catch (e) {
        return null;
    }
}

/**
 * Casador dinâmico para usar dentro dos pageTypes:
 * - Retorna true se o estágio atual estiver na lista `allowedKeys`.
 * - Ex.: cartoesRouteMatches(["desbloqueio:efetivacao", "aceiteDigital:conclusao"])
 */
function cartoesRouteMatches(allowedKeys) {
    try {
        var stage = getCartoesStage();
        if (!stage) return false;
        if (!Array.isArray(allowedKeys) || allowedKeys.length === 0) return false;

        for (var i = 0; i < allowedKeys.length; i++) {
            if (stage === allowedKeys[i]) return true;
        }
        return false;
    } catch (e) {
        return false;
    }
}

// =======================================
// CONTROLE DE DISPARO ÚNICO DE ACTIONS
// =======================================
function runPageTypeOnce(key) {
    if (!window.__evergageFlags) {
        window.__evergageFlags = {};
    }

    if (window.__evergageFlags[key]) {
        return false;
    }

    window.__evergageFlags[key] = true;
    return true;
}

function getScreenNameSafe() {
    try {
        ////////////////////////////////////////////////////
        // HARD GUARD (ANTI TIMING / SAFARI)
        ////////////////////////////////////////////////////
        if (!window.dataLayer || window.dataLayer.length < 2) {
            return "";
        }

        ////////////////////////////////////////////////////
        // BUSCA EM DIFERENTES FORMAS DE DL
        ////////////////////////////////////////////////////
        var el =
            findInDataLayerRevert("ScreenName") ||
            findInDataLayerRevert("screen.path") ||
            findInDataLayerRevert("ep_padrao.screen_name");

        ////////////////////////////////////////////////////
        // VALIDAÇÃO FORTE
        ////////////////////////////////////////////////////
        if (!el || typeof el !== "object") {
            return "";
        }

        ////////////////////////////////////////////////////
        // EXTRAÇÃO SEGURA
        ////////////////////////////////////////////////////
        var screen = "";

        if (el.ScreenName && typeof el.ScreenName === "string") {
            screen = el.ScreenName;
        } 
        else if (el.screen && typeof el.screen === "object" && typeof el.screen.path === "string") {
            screen = el.screen.path;
        } 
        else if (el.ep_padrao && typeof el.ep_padrao === "object" && typeof el.ep_padrao.screen_name === "string") {
            screen = el.ep_padrao.screen_name;
        }

        ////////////////////////////////////////////////////
        // VALIDAÇÃO FINAL
        ////////////////////////////////////////////////////
        if (!screen || typeof screen !== "string") {
            return "";
        }

        ////////////////////////////////////////////////////
        // NORMALIZAÇÃO (CRÍTICO)
        ////////////////////////////////////////////////////
        return screen
            .replace(/\s*\/\s*/g, "/")
            .replace(/\/{2,}/g, "/")
            .replace(/\/+$/, "")
            .trim()
            .toLowerCase();

    } catch (e) {
        return "";
    }
}

// ----------------------------------------------------
// Helper - getLastRelevantScreen
// Estratégia: pega o último screen_name relevante mais recente
// Objetivo: garantir recência sem pegar eventos antigos
// UPDATE: 26/06/2026
// ----------------------------------------------------
function getLastRelevantScreen(matchFn) {
    try {
        var dl = window.dataLayer;

        if (!Array.isArray(dl)) return null;

        for (var i = dl.length - 1; i >= 0; i--) {

            var item = dl[i];

            // só considera Screen_Data (ignora lixo)
            if (!item || item.event !== "Screen_Data") continue;

            var screen = item?.ep_padrao?.screen_name;

            if (typeof screen !== "string") continue;

            var normalized = screen.replace(/\/+$/, "").toLowerCase();

            //PARA NO PRIMEIRO MATCH (MAIS RECENTE)
            if (matchFn(normalized)) {
                return normalized;
            }

            //IMPORTANTE: se encontrou outro estado relevante mais novo,
            // NÃO deve continuar buscando coisa antiga
            if (
                normalized.includes("simulacao") ||
                normalized.includes("confirmacao") ||
                normalized.includes("aprovado")
            ) {
                // significa que já temos um estado mais novo → para busca
                break;
            }
        }

        return null;

    } catch (e) {
        return null;
    }
}

function getCapitalizacaoScreenPath() {
    try {
        if (!window.dataLayer || !window.dataLayer.length) {
            return "";
        }
        ////////////////////////////////////////////////////
        // IGNORA TELAS DE ERRO
        // EVITA REAPROVEITAR O ÚLTIMO SCREEN_DATA VÁLIDO
        ////////////////////////////////////////////////////
        var currentUrl = window.location.href.toLowerCase();
        if (
            currentUrl.indexOf("#/erro") > -1 ||
            currentUrl.indexOf("/erro/") > -1
        ) {
            return "";
        }
        ////////////////////////////////////////////////////
        // BUSCA O ÚLTIMO SCREEN_DATA VÁLIDO
        ////////////////////////////////////////////////////
        for (var i = window.dataLayer.length - 1; i >= 0; i--) {
            var item = window.dataLayer[i];
            if (
                item &&
                item.event === "Screen_Data" &&
                item.screen &&
                typeof item.screen.path === "string"
            ) {
                return item.screen.path
                    .replace(/\s*\/\s*/g, "/")
                    .replace(/\/{2,}/g, "/")
                    .replace(/\/+$/, "")
                    .trim()
                    .toLowerCase();
            }
        }
        return "";
    } catch (e) {
        return "";
    }
}

/**
 * Helpers para identificar o screen path atual a partir do DataLayer.
 * Prioriza o evento de tela mais recente, normaliza o path e permite
 * configurar diferentes contratos de evento/campo sem alterar a lógica base.
 */

function normalizeScreenPath(path) {
    if (typeof path !== "string") {
        return "";
    }

    return path
        .replace(/\s*\/\s*/g, "/")
        .replace(/\/{2,}/g, "/")
        .replace(/\/+$/, "")
        .trim()
        .toLowerCase();
}

function getByPath(obj, path) {
    if (!obj || typeof obj !== "object" || typeof path !== "string") {
        return undefined;
    }

    return path
        .split(".")
        .reduce(
            (current, key) =>
                current && current[key] != null
                    ? current[key]
                    : undefined,
            obj
        );
}

function getLatestScreenPath(
    dataLayer,
    screenEvents = ["Screen_Data"],
    screenPaths = [
        "ScreenName",
        "screen.path",
        "ep_padrao.screen_name"
    ]
) {
    if (!Array.isArray(dataLayer)) {
        return "";
    }

    for (let i = dataLayer.length - 1; i >= 0; i--) {
        const item = dataLayer[i];

        if (!item || typeof item !== "object") {
            continue;
        }

        // Não é evento de tela segundo o contrato
        if (!screenEvents.includes(item.event)) {
            continue;
        }

        for (const path of screenPaths) {
            const candidate = getByPath(item, path);
            const normalized = normalizeScreenPath(candidate);

            if (normalized) {
                return normalized;
            }
        }

        // Evento de tela atual existe,
        // mas não contém um path utilizável.
        return "";
    }

    return "";
}

function getCurrentScreenPath(
    dataLayer,
    currentUrl,
    options = {}
) {
    const {
        invalidUrlFragments = [],
        screenEvents = ["Screen_Data"],
        screenPaths = [
            "ScreenName",
            "screen.path",
            "ep_padrao.screen_name"
        ]
    } = options;

    const url =
        typeof currentUrl === "string"
            ? currentUrl.toLowerCase()
            : "";

    for (const fragment of invalidUrlFragments) {
        if (
            typeof fragment === "string" &&
            url.includes(fragment.toLowerCase())
        ) {
            return "";
        }
    }

    return getLatestScreenPath(
        dataLayer,
        screenEvents,
        screenPaths
    );
}
} catch (e) {
    if (typeof window.Evergage === "object" && typeof window.Evergage.getVersion === "function" && window.Evergage.getVersion() >= 5) {
          console.error("siteWideJavascriptError" + e);    }
};


}