        // handleSPAPageChange();

        const handleFormChange = () => {
            const getForm = () => {
                return Evergage.cashDom(".conteudo.after + form")[0] ? Evergage.cashDom(".conteudo.after + form")[0].getAttribute("name") : "";
            }
            let form = getForm();
            const formChangeInterval = setInterval(() => {
                if (form !== getForm()) {
                    form = getForm();
                    console.log("Evergage.reinit() -- Form Change");
                    Evergage.reinit();
                }
            }, 2000);
        };

        // handleFormChange();

        // valida pageTypes (corrigido)
        configLogada.pageTypes.forEach((pt, i) => {
            if (!pt || typeof pt !== "object") {
                console.log("PageType inválido", i, pt);
                return;
            }

            if (!pt.name) {
                console.log("PageType sem name", i, pt);
            }

            if (typeof pt.isMatch !== "function") {
                console.log("PageType sem isMatch válido", i, pt);
            }
        });

        Evergage.initSitemap(configLogada);
        // reinit quando ID aparecer (login)
        let evergageReinitDone = false;

        waitForUserId(() => {
            if (!evergageReinitDone) {
                evergageReinitDone = true;

                console.log("[Evergage] Reinit com ID válido");

                if (window.Evergage && Evergage.reinit) {
                    Evergage.reinit();
                }
            }
        });
        
        //reinit quando trocar de rota (SPA)
        observeRouteChange();

    } else if (currentCookieDomain === DOMAIN.mobile) {
        const configMobile = {
            global: {
                onActionEvent: (actionEvent) => {
                    /**
                     * (1) sfmcContactKey (ID Salesforce)
                     * - Busca em sessionStorage e localStorage (chaves: idSalesforce/idSalesForce).
                     * - Valida o padrão de 18 chars iniciando com "003".
                     */
                    try {
                    var idSalesforce = null;

                    var s1 = (typeof sessionStorage !== "undefined" && sessionStorage) ? sessionStorage.getItem("idSalesforce") : null;
                    var s2 = (typeof sessionStorage !== "undefined" && sessionStorage) ? sessionStorage.getItem("idSalesForce")  : null;
                    var l1 = (typeof localStorage   !== "undefined" && localStorage)   ? localStorage.getItem("idSalesforce")   : null;
                    var l2 = (typeof localStorage   !== "undefined" && localStorage)   ? localStorage.getItem("idSalesForce")   : null;

                    // primeiro valor válido e não-vazio
                    idSalesforce =
                        (s1 && s1.trim() !== "") ? s1.trim() :
                        (s2 && s2.trim() !== "") ? s2.trim() :
                        (l1 && l1.trim() !== "") ? l1.trim() :
                        (l2 && l2.trim() !== "") ? l2.trim() :
                        null;

                    var regexSf = new RegExp("^003.{15}$");
                    if (idSalesforce && regexSf.test(idSalesforce)) {
                        actionEvent.user = actionEvent.user || {};
                        actionEvent.user.attributes = actionEvent.user.attributes || {};
                        actionEvent.user.attributes.sfmcContactKey = idSalesforce;
                    }
                    } catch (eSf) {
                    // silencioso
                    }

                    /**
                     * (2) perfilInvestidor — ÚNICA FONTE (GLOBAL)
                     * - Lê SEMPRE o último push do dataLayer com user.perfil_investidor (fallback: perfil_investidor na raiz).
                     * - Persiste em localStorage:
                     *     __evg_perfilInvestidor_last      (último valor bruto do DL)
                     *     __evg_perfilInvestidor_last_ts   (timestamp da ÚLTIMA MUDANÇA real)
                     *     __evg_perfilInvestidor_last_sent (último valor enviado ao MCP, para dedupe)
                     * - Expiração: se (agora - last_ts) >= 2 anos => envia "perfil_vencido".
                     * - IMPORTANTE: os page types NÃO devem setar esse atributo (global centraliza).
                     */
                    try {
                    var dl1 = (typeof window !== "undefined" && window.dataLayer && Object.prototype.toString.call(window.dataLayer) === "[object Array]") ? window.dataLayer : [];
                    var perfil = null;

                    // varredura reversa — garante o último push válido
                    for (var i1 = dl1.length - 1; i1 >= 0; i1--) {
                        var obj1 = dl1[i1];
                        if (!obj1 || typeof obj1 !== "object") continue;

                        if (obj1.user && obj1.user.perfil_investidor != null) {
                        var v1 = obj1.user.perfil_investidor;
                        if (!(typeof v1 === "string" && String(v1).trim() === "")) {
                            perfil = String(v1).trim();
                            break;
                        }
                        }
                        if (obj1.perfil_investidor != null) {
                        var v2 = obj1.perfil_investidor;
                        if (!(typeof v2 === "string" && String(v2).trim() === "")) {
                            perfil = String(v2).trim();
                            break;
                        }
                        }
                    }

                    // se não encontrou no DL, faz nada — aguarda próximo evento
                    if (perfil) {
                        var KEY_LAST_ATTR = "__evg_perfilInvestidor_last";
                        var KEY_LAST_TS   = "__evg_perfilInvestidor_last_ts";
                        var KEY_LAST_SENT = "__evg_perfilInvestidor_last_sent";

                        var now = (Date.now ? Date.now() : (new Date()).getTime());
                        var TWO_YEARS_MS = 2 * 365 * 24 * 60 * 60 * 1000;

                        var last = null, lastTsRaw = null, lastTs = NaN, lastSent = null;
                        try { last      = localStorage.getItem(KEY_LAST_ATTR); } catch(e0) {}
                        try { lastTsRaw = localStorage.getItem(KEY_LAST_TS);    } catch(e1) {}
                        try { lastSent  = localStorage.getItem(KEY_LAST_SENT);  } catch(e2) {}

                        if (lastTsRaw) {
                        var parsed = parseInt(lastTsRaw, 10);
                        if (!isNaN(parsed) && isFinite(parsed)) lastTs = parsed;
                        }

                        // atualiza timestamp SOMENTE quando o perfil muda
                        if (last !== perfil) {
                        try { localStorage.setItem(KEY_LAST_ATTR, perfil); } catch(e3) {}
                        try { localStorage.setItem(KEY_LAST_TS, String(now)); lastTs = now; } catch(e4) {}
                        }

                        // se nunca houve ts, inicializa agora
                        if (!isFinite(lastTs)) {
                        try { localStorage.setItem(KEY_LAST_TS, String(now)); lastTs = now; } catch(e5) {}
                        }

                        // expiração de 2 anos
                        var effectivePerfil = perfil;
                        if (isFinite(lastTs) && (now - lastTs) >= TWO_YEARS_MS) {
                        effectivePerfil = "perfil_vencido";
                        }

                        // dedupe persistente
                        if (lastSent !== effectivePerfil) {
                        actionEvent.user = actionEvent.user || {};
                        actionEvent.user.attributes = actionEvent.user.attributes || {};
                        actionEvent.user.attributes.perfilInvestidor = effectivePerfil;
                        try { localStorage.setItem(KEY_LAST_SENT, effectivePerfil); } catch(e6) {}
                        }
                    }
                    } catch (ePI) {
                    // silencioso
                    }
                    
                    return actionEvent;
                }
            },
            pageTypeDefault: {
                name: "default"
            },
            pageTypes: [
                
            // ----------------------------------------------------
            // GLOBAL - LIMPEZA DE CONTEXTO DE JORNADA
            // Estratégia:
            // NÃO confiar em proposta/formalizacao (genéricos)
            // limpar apenas quando houver evidência real de mudança de produto
            // UPDATE: 29/06/2026
            // ----------------------------------------------------
            {
                name: "Global - Clear Journey Context",
            
                isMatch: () => {
                    try {
            
                        var path = window.location.pathname;
            
                        if (typeof path !== "string") return false;
            
                        path = path.toLowerCase();
            
                        ////////////////////////////////////////////////////
                        // 1. FORA DO DOMÍNIO
                        ////////////////////////////////////////////////////
                        if (!path.includes("brairootmbpf")) {
            
                            sessionStorage.removeItem("journey_consignado");
                            sessionStorage.removeItem("journey_timestamp");
            
                            return false;
                        }
            
                        ////////////////////////////////////////////////////
                        // 2. ENTRADA EXPLÍCITA DE E-SOCIAL (URL FORTE)
                        ////////////////////////////////////////////////////
                        if (path.includes("/e-social/")) {
            
                            sessionStorage.removeItem("journey_consignado");
                            sessionStorage.removeItem("journey_timestamp");
            
                            return false;
                        }
            
                        ////////////////////////////////////////////////////
                        // 3. DETECÇÃO VIA DATA LAYER (PRINCIPAL)
                        ////////////////////////////////////////////////////
                        var obj = findInDataLayerRevert("ep_padrao.screen_name");
                        var screen = obj?.ep_padrao?.screen_name;
            
                        if (typeof screen === "string") {
            
                            screen = screen.toLowerCase();
            
                            // mudou para outro produto → limpa
                            if (
                                screen.includes("/inss/") ||
                                screen.includes("refinanciamento") ||
                                screen.includes("publico") ||
                                screen.includes("e-social")
                            ) {
            
                                sessionStorage.removeItem("journey_consignado");
                                sessionStorage.removeItem("journey_timestamp");
            
                            }
                        }
            
                        ////////////////////////////////////////////////////
                        // NÃO limpa em proposta / formalização
                        ////////////////////////////////////////////////////
            
                        return false;
            
                    } catch (e) {
                        return false;
                    }
                }
            },

                //Nova Home_clique em Ver saldo - atualizado em 20/01/2025
                {
                    name: "Mobile - Nova Home - Clique ver saldo",
                    action: DESC_DOMAIN.mobile + TIPO_ATIVIDADE.novaHome.home + " - Login",
                    isMatch: () => /\/bcpfhome\/#\/home/.test(window.location.href),
                    listeners: [
                        Evergage.listener(EVENTS.click, ".balance__body", () => {
                            var currentUrl = window.location.href;
                            var timerTrigger;
                            if (!timerTrigger) {
                                timerTrigger = setInterval(function () {
                                    if (currentUrl != window.location.href) {
                                        clearInterval(timerTrigger);
                                    } else {
                                        var saldoElement = Evergage.cashDom(".balance__body")[0];
                                        if (saldoElement) {
                                            var saldo = Evergage.cashDom(".balance__body")[0].innerText;
                                            var saldoNumerico = parseFloat(saldo.replace(/\./g, "").replace(",", ".").replace(/[^0-9.-]/g, ''));
                                            if (saldo) {
                                                Evergage.sendEvent({
                                                    action: DESC_DOMAIN.mobile + TIPO_ATIVIDADE.novaHome.home + " - Clique Ver Saldo",
                                                    user: {
                                                        attributes: {
                                                            saldoPositivo: saldoNumerico >= 0,
                                                            saldoMobile: saldoNumerico,
                                                        }
                                                    }
                                                });
                                            }
                                            clearInterval(timerTrigger);
                                        }
                                    }
                                }, 2000);
                            }
