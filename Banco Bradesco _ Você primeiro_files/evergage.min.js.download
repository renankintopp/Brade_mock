const EVENTS = {
    click: "click",
    submit: "submit",
    findLinkByDataTitleInsensitive: (value) => "a[data-title='" + value + "' i]",
    findLinkByTitleInsensitive: (value) => "a[title='" + value + "' i]",
    findTabByRelInsensitive: (value) => ".tabsScroll li[rel='" + value + "' i]",
    findFormByNameInsensitive: (value) => "form[name='" + value + "' i]",
    findLinkByHrefSubstring: (value) => "a[href*='" + value + "' i]",
    findButtonByTitle: (value) => "button[title = '" + value + "' i]",
};

// ===============================
// MCP: Listas de hosts reconhecidos - update em 17/11/2025
// ===============================

const getCookieDomain = () => {

    let currentDomain = window.location.hostname;

    if (/m3.bradesco.com.br/.test(currentDomain) || /m2.bradesco.com.br/.test(currentDomain) ||
        /m.bradesco.com.br/.test(currentDomain) || /proxy.api.banco.bradesco/.test(currentDomain) ||
        /static.neth.bradesco.com.br/.test(currentDomain) || /static.prebanco.com.br/.test(currentDomain) ||
        /static.bradesco.com.br/.test(currentDomain) || /pf.bradesco.com/.test(currentDomain) ||
        /pf.api.prebanco.com.br/.test(currentDomain)
        ){
        return DOMAIN.mobile;
    } else if (/bradesco\.com\.br/.test(currentDomain)) {
        return DOMAIN.areaLogada;
    } else {
        return DOMAIN.areaNaoLogada;
    }
}

const cookieDomain = () => {
    let currentDomain = window.location.hostname;

    if (/banco\.bradesco/.test(currentDomain)) {
        return "banco.bradesco";
    } else if (/bradescard.com.br/.test(currentDomain)) {
        return "bradescard.com.br";
    } else {
        return "bradesco.com.br";
    }
}

// =====================================================
// Inicialização 
// =====================================================
const currentCookieDomain = getCookieDomain();
const cookiesetter = cookieDomain();

var trackAnonymousVisitors = true;

if (currentCookieDomain === DOMAIN.mobile) {
  trackAnonymousVisitors = false;
  console.log(trackAnonymousVisitors);
  console.log("trackAnonymousVisitors mobile");
}

if (currentCookieDomain === DOMAIN.areaLogada) {
  trackAnonymousVisitors = false;
  console.log(trackAnonymousVisitors);
  console.log("trackAnonymousVisitors areaLogada");
} // start line 468 - end line 520

Evergage.init({
    cookieDomain: cookiesetter,
    trackAnonymousVisitors: trackAnonymousVisitors
}).then(() => {
    if (currentCookieDomain == DOMAIN.areaNaoLogada) {
    } else if (currentCookieDomain == DOMAIN.areaLogada) {
        const configLogada = {
            global: {
                onActionEvent: (actionEvent) => {
                    /**
                     * (1) sfmcContactKey (ID Salesforce)
                     */
                    try {
                        var idSalesforce = getUserId(); // NOVO (SPA)
                        // fallback (mantém sua lógica caso helper falhe)
                        if (!idSalesforce) {
                            var s1 = (typeof sessionStorage !== "undefined" && sessionStorage) ? sessionStorage.getItem("idSalesforce") : null;
                            var s2 = (typeof sessionStorage !== "undefined" && sessionStorage) ? sessionStorage.getItem("idSalesForce")  : null;
                            var l1 = (typeof localStorage   !== "undefined" && localStorage)   ? localStorage.getItem("idSalesforce")   : null;
                            var l2 = (typeof localStorage   !== "undefined" && localStorage)   ? localStorage.getItem("idSalesForce")   : null;
                            idSalesforce =
                                (s1 && s1.trim() !== "") ? s1.trim() :
                                (s2 && s2.trim() !== "") ? s2.trim() :
                                (l1 && l1.trim() !== "") ? l1.trim() :
                                (l2 && l2.trim() !== "") ? l2.trim() :
                                null;
                        }
                        var regexSf = new RegExp("^003.{15}$");
                        if (idSalesforce && regexSf.test(idSalesforce)) {
                            actionEvent.user = actionEvent.user || {};
                            actionEvent.user.attributes = actionEvent.user.attributes || {};

                            //lógica original
                            actionEvent.user.attributes.sfmcContactKey = idSalesforce;

                            // CRÍTICO (identidade do usuário no Personalization)
                            actionEvent.user.id = idSalesforce;
                            console.log("[Evergage] ID aplicando no evento:", idSalesforce);
                        } else {
                            console.log("[Evergage] ID inválido ou não encontrado ainda");
                        }
                    } catch (eSf) {
                        // silencioso
                    }
                    /**
                     * (2) perfilInvestidor — MANTIDO 100% IGUAL
                     */
                    try {
                        var dl1 = (typeof window !== "undefined" && window.dataLayer && Object.prototype.toString.call(window.dataLayer) === "[object Array]") ? window.dataLayer : [];
                        var perfil = null;

                        for (var i1 = dl1.length - 1; i1 >= 0; i1--) {
                            var obj1 = dl1[i1];
                            if (!obj1 || typeof obj1 !== "object") continue;

                            if (obj1.user && obj1.user.perfil_investidor != null) {
                                var v1 = obj1.user.perfil_investidor;
                                if (!(typeof v1 === "string" && String(v1).trim() === "")) {
                                    perfil = String(v1).trim();
                                    break;
                                }
                            }
                            if (obj1.perfil_investidor != null) {
                                var v2 = obj1.perfil_investidor;
                                if (!(typeof v2 === "string" && String(v2).trim() === "")) {
                                    perfil = String(v2).trim();
                                    break;
                                }
                            }
                        }

                        if (perfil) {
                            var KEY_LAST_ATTR = "__evg_perfilInvestidor_last";
                            var KEY_LAST_TS   = "__evg_perfilInvestidor_last_ts";
                            var KEY_LAST_SENT = "__evg_perfilInvestidor_last_sent";

                            var now = (Date.now ? Date.now() : (new Date()).getTime());
                            var TWO_YEARS_MS = 2 * 365 * 24 * 60 * 60 * 1000;
                            var last = null, lastTsRaw = null, lastTs = NaN, lastSent = null;
                            try { last      = localStorage.getItem(KEY_LAST_ATTR); } catch(e0) {}
                            try { lastTsRaw = localStorage.getItem(KEY_LAST_TS);    } catch(e1) {}
                            try { lastSent  = localStorage.getItem(KEY_LAST_SENT);  } catch(e2) {}
                            if (lastTsRaw) {
                                var parsed = parseInt(lastTsRaw, 10);
                                if (!isNaN(parsed) && isFinite(parsed)) lastTs = parsed;
                            }
                            if (last !== perfil) {
                                try { localStorage.setItem(KEY_LAST_ATTR, perfil); } catch(e3) {}
                                try { localStorage.setItem(KEY_LAST_TS, String(now)); lastTs = now; } catch(e4) {}
                            }
                            if (!isFinite(lastTs)) {
                                try { localStorage.setItem(KEY_LAST_TS, String(now)); lastTs = now; } catch(e5) {}
                            }
                            var effectivePerfil = perfil;
                            if (isFinite(lastTs) && (now - lastTs) >= TWO_YEARS_MS) {
                                effectivePerfil = "perfil_vencido";
                            }
                            if (lastSent !== effectivePerfil) {
                                actionEvent.user = actionEvent.user || {};
                                actionEvent.user.attributes = actionEvent.user.attributes || {};
                                actionEvent.user.attributes.perfilInvestidor = effectivePerfil;
                                try { localStorage.setItem(KEY_LAST_SENT, effectivePerfil); } catch(e6) {}
                            }
                        }
                    } catch (ePI) {
                        // silencioso
                    }
                    return actionEvent;
                },
