               // CONSIGNADO - Novas actions por DL update em 14/04/2026
                ////////////////////////////////////////////////////
                // CONSIGNADO PUBLICO MOBILE PF UPDATE - 28/04/26 //
                ////////////////////////////////////////////////////
                // ----------------------------------------------------
                // Consignado Público - SIMULAÇÃO
                // Baseado em getDataLayerValueSmart (igual privado contratação)
                // UPDATE: conversão do modelo lista para comparator
                // MODELO HIBRIDO EVITAR VAZAMENTO PARA CARTOES
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Publico - Simular",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPublico +
                        " - Simular",
                
                    isMatch: () => {
                        try {
                
                            //  1 Fonte principal: ÚLTIMO evento (contexto real)
                            const lastObj = findInDataLayerRevert("ep_padrao.screen_name");
                            const lastValue = lastObj?.ep_padrao?.screen_name;
                
                            if (!lastValue) return false;
                
                            const lastMatch =
                                lastValue.includes("consignado-novo/publico") &&
                                lastValue.includes("simulacao");
                
                            if (!lastMatch) return false;
                
                            // 2. (opcional) Smart como validação secundária
                            const smartMatch =
                                getDataLayerValueSmart(
                                    window.dataLayer,
                                    "Screen_Data",
                                    "ep_padrao.screen_name",
                                    v => v && v.includes("consignado-novo/publico")
                                ) !== undefined;
                
                            // só aceita se os dois fizerem sentido
                            if (!smartMatch) {
                                // log futuro se quiser debugar inconsistência
                                // console.warn("Mismatch Smart vs Revert");
                            }

                            return true;
                
                        } catch (e) {
                            return false;
                        }
                    }
                },
                
                // ----------------------------------------------------
                // Consignado Público - RESUMO DA PROPOSTA (CONFIRMAÇÃO)
                // Fonte: ep_padrao.screen_name (Screen_Data)
                // Estratégia: híbrido (Revert + validação + controle de duplicidade)
                // UPDATE: 18/05/2026 - ajuste para evitar inflar volume
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Publico - Resumo da Proposta",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPublico +
                        TIPO_ATIVIDADE.emprestimo.resumoPropostaEmprestimo,
                    isMatch: () => {
                        try {
                            // 1. Fonte principal: ÚLTIMO estado da navegação (evita histórico sujo)
                            const lastObj = findInDataLayerRevert("ep_padrao.screen_name");
                            const lastValue = lastObj?.ep_padrao?.screen_name;
                
                            if (!lastValue) return false;
                
                            // 2. Lista fechada (base GA + BE)
                            const RESUMO_PUBLICO_PATHS = [
                                "consignado-novo/publico/com-oferta-seguro/confirmacao",
                                "consignado-novo/publico/sem-oferta-seguro/confirmacao",
                                "consignado-novo/publico/aceite-re-oferta/confirmacao",
                                "consignado-novo/publico/confirmacao",
                                "consignado-novo/publico/sem-aceite-re-oferta/confirmacao"
                            ];
                
                            const lastMatch = RESUMO_PUBLICO_PATHS.some(path =>
                                lastValue.includes(path)
                            );
                            if (!lastMatch) return false;
                
                            // 3. (opcional) validação secundária com Smart (debug)
                            const smartMatch =
                                getDataLayerValueSmart(
                                    window.dataLayer,
                                    "Screen_Data",
                                    "ep_padrao.screen_name",
                                    v => v && v.includes("consignado-novo/publico")
                                ) !== undefined;
                
                            // não bloqueia, mas pode logar inconsistência
                            // if (!smartMatch) console.warn("Mismatch Smart vs Revert");
                            // 4. Controle de duplicidade (crítico em SPA)
                            if (!runPageTypeOnce("consignado_publico_resumo")) return false;
                            return true;
                        } catch (e) {
                            return false;
                        }
                    }
                },
                
                // ----------------------------------------------------
                // Consignado Público - CONTRATAÇÃO (APROVADO)
                // Fonte: último Screen_Data real (Revert)
                // Estratégia: lista fechada (match exato)
                // UPDATE: 22/05/2026 - correção de inflar por uso de Smart
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Publico - Contratar",
                
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPublico +
                        " - Contratar",
                
                    isMatch: () => {
                        try {
                
                            const obj = findInDataLayerRevert("ep_padrao.screen_name");
                
                            // 1. valida existência
                            if (!obj) return false;
                
                            // 2. garante evento correto
                            if (obj.event !== "Screen_Data") return false;
                
                            const value = obj?.ep_padrao?.screen_name;
                
                            if (!value) return false;
                
                            // 3. lista fechada rígida
                            const validPaths = [
                                "consignado-novo/publico/com-oferta-seguro/aprovado",
                                "consignado-novo/publico/sem-oferta-seguro/aprovado",
                                "consignado-novo/publico/aceite-re-oferta/aprovado",
                                "consignado-novo/publico/sem-aceite-re-oferta/aprovado",
                                "consignado-novo/publico/aprovado"
                            ];
                
                            return validPaths.includes(value);
                
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // Consignado Público - EM ANÁLISE
                // Fonte: ep_padrao.screen_name (DataLayer)
                // Estratégia: lista fechada + revert (base GA)
                // UPDATE: 18/05/2026 - padronização com controle de contexto e duplicidade
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Publico - Em Analise",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPublico +
                        " - Em Analise",
                
                    isMatch: () => {
                        try {
                            // 1. Obtém o último Screen_Data da navegação (estado real)
                            const obj = findInDataLayerRevert("ep_padrao.screen_name");
                            const value = obj?.ep_padrao?.screen_name;
                
                            if (!value) return false;
                
                            // 2. Lista fechada de caminhos (alinhada ao GA e documentação)
                            const EM_ANALISE_PUBLICO_PATHS = [
                                "consignado-novo/publico/com-oferta-seguro/em-analise",
                                "consignado-novo/publico/sem-oferta-seguro/em-analise",
                                "consignado-novo/publico/aceite-re-oferta/em-analise",
                                "consignado-novo/publico/sem-aceite-re-oferta/em-analise",
                                "consignado-novo/publico/em-analise"
                            ];
                
                            // 3. Match controlado via includes (robusto contra pequenas variações)
                            const match = EM_ANALISE_PUBLICO_PATHS.some(path =>
                                value.includes(path)
                            );
                
                            if (!match) return false;
                
                            // 4. Controle de duplicidade (SPA / re-render / múltiplos pushes)
                            // if (!runPageTypeOnce("consignado_publico_em_analise")) return false;
                
                            return true;
                
                        } catch (e) {
                            return false;
                        }
                    }
                },
                
                //////////////////////////////////////////
                // CONSIGNADO PRIVADO MOBILE PF         //
                //////////////////////////////////////////
                
                // ----------------------------------------------------
                // Consignado Privado - ENTRADA JORNADA
                // Estratégia: marcar sessionStorage de forma síncrona
                // Objetivo: iniciar contexto da jornada com controle de reentrada
                // UPDATE: 29/06/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Privado - Entrada Jornada",
                    isMatch: () => {
                        try {
                
                            ////////////////////////////////////////////////////
                            // 1. URL
                            ////////////////////////////////////////////////////
                            var path = window.location.pathname;
                            if (typeof path !== "string") return false;
                
                            path = path.toLowerCase();
                
                            ////////////////////////////////////////////////////
                            // 2. MATCH DE ENTRADA
                            ////////////////////////////////////////////////////
                            var isEntrada =
                                path.includes("/brairootmbpf/privado/lista-vinculos");
                
                            ////////////////////////////////////////////////////
                            // 3. SET CONTEXTO (SOMENTE QUANDO NECESSÁRIO)
                            ////////////////////////////////////////////////////
                            if (isEntrada) {
                
                                var current = sessionStorage.getItem("journey_consignado");
                
                                if (current !== "privado") {
                                    sessionStorage.setItem("journey_consignado", "privado");
                                    sessionStorage.setItem("journey_timestamp", Date.now().toString());
                                }
                            }
                            return false;
                        } catch (e) {
                            return false;
                        }
                    }
                },                
                
                // ----------------------------------------------------
                // Consignado Privado - Aceite Dataprev
                // Estratégia:
                // 1. URL
                // 2. Bloqueio de etapas posteriores
                // 3. DataLayer
                // Objetivo:
                // evitar vazamento para Simulação e demais etapas
                // UPDATE: 06/07/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Privado - Aceite Dataprev",
                
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivado +
                        " - Aceite Dataprev",
                
                    isMatch: () => {
                        try {
                
                            ////////////////////////////////////////////////////
                            // URL
                            ////////////////////////////////////////////////////
                            var path = window.location.pathname?.toLowerCase();
                
                            if (!path) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // BLOQUEIOS
                            ////////////////////////////////////////////////////
                            if (
                                path.includes("/lista-vinculos") ||
                                path.includes("/simulacao") ||
                                path.includes("/proposta") ||
                                path.includes("/biometria") ||
                                path.includes("/formalizacao")
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // DL
                            ////////////////////////////////////////////////////
                            var screenName = getScreenNameFromDataLayer();
                
                            if (typeof screenName !== "string") {
                                return false;
                            }
                
                            screenName = screenName.toLowerCase();
                
                            ////////////////////////////////////////////////////
                            // MATCH FINAL
                            ////////////////////////////////////////////////////
                            return (
                                screenName === "consignado-novo/privado/dataprev"
                            );
                
                        } catch {
                            return false;
                        }
                    }
                },
                
                // ----------------------------------------------------
                // Consignado Privado - SIMULAÇÃO
                // Estratégia:
                // 1. URL (entrypoint real)
                // 2. Bloqueio de etapas indevidas
                // 3. DataLayer (fallback)
                // Objetivo:
                // eliminar duplicidade e evitar falso positivo
                // UPDATE: 30/06/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Privado - Simular",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivado +
                        " - Simular",
                
                    isMatch: () => {
                        try {
                
                            var path = window.location.pathname;
                            if (typeof path !== "string") return false;
                
                            path = path.toLowerCase();
                
                            ////////////////////////////////////////////////////
                            // BLOQUEIOS IMPORTANTES
                            ////////////////////////////////////////////////////
                            if (
                                path.includes("/proposta") ||
                                path.includes("/formalizacao") ||
                                path.includes("/biometria")
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // ENTRYPOINT (ÚNICO CONFIÁVEL)
                            ////////////////////////////////////////////////////
                            if (
                                path.includes("/brairootmbpf/privado/lista-vinculos") &&
                                path.includes("simulacao")
                            ) {
                                return true;
                            }
                
                            ////////////////////////////////////////////////////
                            // DL (FALLBACK CONTROLADO)
                            ////////////////////////////////////////////////////
                            var obj = findInDataLayerRevert("ep_padrao.screen_name");
                            var screen = obj?.ep_padrao?.screen_name;
                
                            if (typeof screen !== "string") return false;
                
                            screen = screen.toLowerCase();
                
                            if (
                                screen.includes("consignado-novo/privado") &&
                                screen.includes("simulacao") &&
                                !screen.includes("e-social") &&
                                !screen.includes("refinanciamento") &&
                                !screen.includes("/inss/") &&
                                !screen.includes("publico")
                            ) {
                                return true;
                            }
                
                            return false;
                
                        } catch (e) {
                            return false;
                        }
                    }
                },
                
                // ----------------------------------------------------
                // Consignado Privado - RESUMO PROPOSTA
                // Estratégia:
                // 1. URL (etapa obrigatória)
                // 2. DataLayer (principal - flexível)
                // 3. Session (fallback leve)
                // 4. Bloqueios explícitos
                // 5. Controle de duplicidade
                // Objetivo:
                // aumentar cobertura sem inflar e sem vazamento
                // UPDATE: 30/06/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Privado - Resumo Proposta",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivado +
                        TIPO_ATIVIDADE.emprestimo.resumoPropostaEmprestimo,
                
                    isMatch: () => {
                        try {
                            ////////////////////////////////////////////////////
                            // 1. URL (ETAPA)
                            ////////////////////////////////////////////////////
                            var path = window.location.pathname?.toLowerCase();
                            if (!path || !path.includes("/proposta")) return false;
                
                            ////////////////////////////////////////////////////
                            // 2. CONTROLE DUPLICIDADE
                            ////////////////////////////////////////////////////
                            var alreadyFired =
                                sessionStorage.getItem("privado_resumo_fired") === "true";
                            if (alreadyFired) return false;
                
                            ////////////////////////////////////////////////////
                            // 3. SESSION (JORNADA)
                            ////////////////////////////////////////////////////
                            var isPrivado =
                                sessionStorage.getItem("journey_consignado") === "privado";
                
                            ////////////////////////////////////////////////////
                            // 4. DATA LAYER
                            ////////////////////////////////////////////////////
                            var obj = findInDataLayerRevert("ep_padrao.screen_name");
                            var screen = obj?.ep_padrao?.screen_name?.toLowerCase();
                
                            ////////////////////////////////////////////////////
                            // 5. BLOQUEIOS
                            ////////////////////////////////////////////////////
                            if (
                                screen &&
                                (
                                    screen.includes("e-social") ||
                                    screen.includes("refinanciamento") ||
                                    screen.includes("/inss/") ||
                                    screen.includes("publico")
                                )
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // 6. MATCH DL (FLEXIBILIZADO)
                            ////////////////////////////////////////////////////
                            var matchDL =
                                screen &&
                                screen.includes("consignado-novo/privado") &&
                                (
                                    screen.includes("confirmacao") ||
                                    screen.includes("resumo") ||        // fallback comum
                                    screen.includes("proposta")         // fallback SPA
                                );
                
                            ////////////////////////////////////////////////////
                            // 7. MATCH FINAL
                            ////////////////////////////////////////////////////
                            if (
                                matchDL ||
                                (
                                    isPrivado &&
                                    screen &&
                                    screen.includes("consignado-novo/privado")
                                )
                            ) {
                                sessionStorage.setItem("privado_resumo_fired", "true");
                                return true;
                            }
                            return false;
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // Consignado Privado - CONTRATAÇÃO
                // Estratégia:
                // 1. SessionStorage (principal)
                // 2. DataLayer (fallback)
                // 3. Controle de duplicidade
                //
                // Objetivo:
                // Utilizar a chave disponibilizada pelo BE como
                // principal identificador da contratação,
                // mantendo fallback pelo DataLayer.
                //
                // UPDATE: 29/07/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Privado - Contratar",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivado +
                        " - Contratar",
                
                    isMatch: () => {
                        try {
                            ////////////////////////////////////////////////////
                            // CONTROLE DE DUPLICIDADE
                            ////////////////////////////////////////////////////
                            var jaDisparou =
                                sessionStorage.getItem(
                                    "privado_contratacao_disparada"
                                );
                            if (jaDisparou === "true") {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // MATCH PRINCIPAL - SESSION STORAGE
                            ////////////////////////////////////////////////////
                            var matchSession =
                                sessionStorage.getItem(
                                    "consignado-privado"
                                ) === "true";
                
                            ////////////////////////////////////////////////////
                            // MATCH FALLBACK - DATALAYER
                            ////////////////////////////////////////////////////
                            var screen = getScreenNameSafeExact(function(screen) {
                                return (
                                    screen.includes("consignado-novo/privado") &&
                                    (
                                        screen.includes("aprovado") ||
                                        screen.includes("modal-avaliador")
                                    )
                                );
                            });
                            var matchDL = !!screen;
                            ////////////////////////////////////////////////////
                            // MATCH FINAL
                            ////////////////////////////////////////////////////
                            if (matchSession || matchDL) {
                                sessionStorage.setItem(
                                    "privado_contratacao_disparada",
                                    "true"
                                );
                                return true;
                            }
                            return false;
                        } catch (e) {
                            return false;
                        }
                    }
                },

                // {
                //     name: "Mobile - Emprestimo - Credito Consignado Privado - Contratar",
                //     action:
                //         DESC_DOMAIN.mobile +
                //         PRODUTO.emprestimo.emprestimo +
                //         PRODUTO.emprestimo.creditoConsignadoPrivado +
                //         " - Contratar",
