                        try {
                            /* =========================
                            * 1) DATALAYER - screen.path
                            * ========================= */
                            let dlOk = false;

                            try {
                                const obj = findInDataLayerRevert("screen.path");
                                const path = obj?.screen?.path;

                                if (typeof path === "string") {
                                    const normalizedPath = path
                                        .replace(/\s*\/\s*/g, "/")
                                        .replace(/\/{2,}/g, "/")
                                        .replace(/\/+$/, "")
                                        .trim()
                                        .toLowerCase();

                                    dlOk = normalizedPath === "menu-emprestimos/home";
                                }
                            } catch (e) {
                                // DL pode não existir, segue fallback
                            }

                            /* =========================
                            * 2) FALLBACK - URL
                            * ========================= */
                            const pathname = window.location.pathname || "";

                            const urlOk =
                                /\/bcpf_elegibilidade\/signin/.test(pathname) ||
                                /\/brairootmbpf\/menu-consig\/main/.test(pathname) ||
                                /\/brain\/v1\/brai-fed-menu-emprest\/?$/.test(pathname) ||
                                /\/braimenuempstm/.test(pathname);

                            /* =========================
                            * 3) REGRA FINAL
                            * ========================= */
                            return dlOk || urlOk;

                        } catch (e) {
                            return false;
                        }
                    }
                },
                
