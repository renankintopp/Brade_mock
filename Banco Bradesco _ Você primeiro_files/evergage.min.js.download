                // Perfil Investidor - alterado em 28/01/26
                {
                name: "investimento_mobile_perfil_investidor",
                action: DESC_DOMAIN.mobile + "Investimentos - " + PRODUTO.investimento.perfilInvestidor,
                isMatch: () => /\/front_apl\/ciar-fed-api-inv\/?$/.test(window.location.pathname),

                // Apenas dispara a Action “Perfil X” — o atributo é responsabilidade do GLOBAL
                onActionEvent: (actionEvent) => {
                    try {
                    const dl = (typeof window !== "undefined" && window.dataLayer && Object.prototype.toString.call(window.dataLayer) === "[object Array]") ? window.dataLayer : [];
                    let perfil = null;

                    // Captura determinística do último perfil_investidor
                    for (let i = dl.length - 1; i >= 0; i--) {
                        const obj = dl[i];
                        if (!obj || typeof obj !== "object") continue;

                        if (obj.user && obj.user.perfil_investidor != null) {
                        const v1 = obj.user.perfil_investidor;
                        if (!(typeof v1 === "string" && String(v1).trim() === "")) {
                            perfil = String(v1).trim();
                            break;
                        }
                        }
                        if (obj.perfil_investidor != null) {
                        const v2 = obj.perfil_investidor;
                        if (!(typeof v2 === "string" && String(v2).trim() === "")) {
                            perfil = String(v2).trim();
                            break;
                        }
                        }
                    }

                    if (!perfil) return actionEvent;

                    const LABEL = {
                        conservador: "Conservador",
                        moderado: "Moderado",
                        dinamico: "Dinâmico",
                        arrojado: "Arrojado",
                        ultraconservador: "Ultraconservador"
                    };
                    const label = LABEL[perfil] || perfil;

                    const actionBase = DESC_DOMAIN.mobile + "Investimentos - " + PRODUTO.investimento.perfilInvestidor;
                    const actionComPerfil = actionBase + " - Perfil " + label;

                    const KEY_SENT_PREFIX = "__evg_perfilInvestidor_action_sent__";
                    const sentKey = KEY_SENT_PREFIX + (location.pathname || "") + "::" + perfil + "::base";

                    try {
                        if (sessionStorage.getItem(sentKey) !== "1") {
                        actionEvent.action = actionComPerfil;
                        sessionStorage.setItem(sentKey, "1");
                        }
                    } catch (eSent) {}

                    // NÃO setar atributo aqui — o GLOBAL já centraliza
                    return actionEvent;
                    } catch (e) { return actionEvent; }
                }
                },
                {
                name: "investimento_mobile_perfil_investidor - Atualizar perfil",
                action: DESC_DOMAIN.mobile + "Investimentos - " + PRODUTO.investimento.perfilInvestidor + " - Atualizar perfil",
                isMatch: () => /\/cinvmbperfinve\/home#\/home\/?/.test(window.location.href),

                // Listener “Concluir”: persiste novo perfil no localStorage e força reenvio via sendEvent
                listeners: [
                    Evergage.listener(EVENTS.click, "[aria-label*='Concluir']", () => {
                    // 1) Tenta capturar o novo perfil do DL imediatamente (se já foi empurrado)
                    let novoPerfil = null;
                    try {
                        const dl = (window.dataLayer && Object.prototype.toString.call(window.dataLayer) === "[object Array]") ? window.dataLayer : [];
                        for (let i = dl.length - 1; i >= 0; i--) {
                        const obj = dl[i];
                        if (!obj || typeof obj !== "object") continue;

                        if (obj.user && obj.user.perfil_investidor != null) {
                            const v1 = obj.user.perfil_investidor;
                            if (!(typeof v1 === "string" && String(v1).trim() === "")) {
                            novoPerfil = String(v1).trim();
                            break;
                            }
                        }
                        if (obj.perfil_investidor != null) {
                            const v2 = obj.perfil_investidor;
                            if (!(typeof v2 === "string" && String(v2).trim() === "")) {
                            novoPerfil = String(v2).trim();
                            break;
                            }
                        }
                        }
                    } catch (eCap) {}

                    // 2) Se obteve o novo perfil, persiste imediatamente e invalida dedupe
                    try {
                        const KEY_LAST_ATTR = "__evg_perfilInvestidor_last";
                        const KEY_LAST_TS   = "__evg_perfilInvestidor_last_ts";
                        const KEY_LAST_SENT = "__evg_perfilInvestidor_last_sent";
                        const now = Date.now ? Date.now() : (new Date()).getTime();

                        if (novoPerfil) {
                        localStorage.setItem(KEY_LAST_ATTR, novoPerfil);
                        localStorage.setItem(KEY_LAST_TS, String(now));
                        localStorage.removeItem(KEY_LAST_SENT); // força reenvio no próximo onActionEvent (GLOBAL)
                        }
                    } catch (eSet) {}

                    // 3) Dispara o evento já existente de “Concluir”
                    Evergage.sendEvent({
                        action: DESC_DOMAIN.mobile + "Investimentos - " + PRODUTO.investimento.perfilInvestidor + " - Questionario - Concluir"
                    });

                    // 4) (Opcional) Dispara um evento leve extra para garantir que o GLOBAL rode agora
                    Evergage.sendEvent({
                        action: DESC_DOMAIN.mobile + "Investimentos - " + PRODUTO.investimento.perfilInvestidor + " - Atualizado"
                    });
                    })
                ],

                // Apenas dispara a Action “Atualizar perfil – Perfil X” — atributo fica a cargo do GLOBAL
                onActionEvent: (actionEvent) => {
                    try {
                    const dl = (typeof window !== "undefined" && window.dataLayer && Object.prototype.toString.call(window.dataLayer) === "[object Array]") ? window.dataLayer : [];
                    let perfil = null;

                    // Captura determinística do último perfil_investidor
                    for (let i = dl.length - 1; i >= 0; i--) {
                        const obj = dl[i];
                        if (!obj || typeof obj !== "object") continue;

                        if (obj.user && obj.user.perfil_investidor != null) {
                        const v1 = obj.user.perfil_investidor;
                        if (!(typeof v1 === "string" && String(v1).trim() === "")) {
                            perfil = String(v1).trim();
                            break;
                        }
                        }
                        if (obj.perfil_investidor != null) {
                        const v2 = obj.perfil_investidor;
                        if (!(typeof v2 === "string" && String(v2).trim() === "")) {
                            perfil = String(v2).trim();
                            break;
                        }
                        }
                    }

                    if (!perfil) return actionEvent;

                    const LABEL = {
                        conservador: "Conservador",
                        moderado: "Moderado",
                        dinamico: "Dinâmico",
                        arrojado: "Arrojado",
                        ultraconservador: "Ultraconservador"
                    };
                    const label = LABEL[perfil] || perfil;

                    const actionBase = DESC_DOMAIN.mobile + "Investimentos - " + PRODUTO.investimento.perfilInvestidor;
                    const actionComPerfil = actionBase + " - Atualizar perfil - Perfil " + label;

                    const KEY_SENT_PREFIX = "__evg_perfilInvestidor_action_sent__";
                    const sentKey = KEY_SENT_PREFIX + (location.pathname || "") + "::" + perfil + "::atualizar";

                    try {
                        if (sessionStorage.getItem(sentKey) !== "1") {
                        actionEvent.action = actionComPerfil;
                        sessionStorage.setItem(sentKey, "1");
                        }
                    } catch (eSent) {}

                    // NÃO setar atributo aqui — o GLOBAL já centraliza
                    return actionEvent;
                    } catch (e) { return actionEvent; }
                }
                },

