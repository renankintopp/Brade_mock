                *
                * Path:
                *   credito-parcelado/novo/erro-nao-foi-possivel-acessar-contrato
                *
                * Erro controlado. Sem itemAction.
                * ----------------------------------------------------- */
                {
                    name: "emprestimo_mobile_credito_parcelado_erro_acessar_contrato",
                    action:
                        DESC_DOMAIN.mobile
                        + PRODUTO.emprestimo.emprestimo
                        + PRODUTO.emprestimo.creditParcelado
                        + " - Erro - Acessar contrato",
                
                    isMatch: () => {
                        try {
                            var screen = getScreenNameSafe();
                
                            if (!screen) return false;
                
                            return /^credito-parcelado\/novo\/erro-nao-foi-possivel-acessar-contrato$/.test(screen);
                
                        } catch (e) {
                            return false;
                        }
                    }
                },

                /* -----------------------------------------------------
                * 7) ERRO 2 – "Contratação indisponível para esta conta"
                *
                * Path:
                *   credito-parcelado/novo/erro-contratacao-indisponivel-para-esta-conta
                *
                * Erro funcional controlado. Sem itemAction.
                * ----------------------------------------------------- */
                {
                    name: "emprestimo_mobile_credito_parcelado_erro_indisponivel_conta",
                    action:
                        DESC_DOMAIN.mobile
                        + PRODUTO.emprestimo.emprestimo
                        + PRODUTO.emprestimo.creditParcelado
                        + " - Erro - Contratacao indisponivel",

                    isMatch: () => {
                        const obj = findInDataLayerRevert("screen.path");
                        if (!obj?.screen?.path) return false;

                        const path = obj.screen.path
                            .replace(/\s*\/\s*/g, "/")
                            .replace(/\/{2,}/g, "/")
                            .replace(/\/+$/, "")
                            .trim()
                            .toLowerCase();

                        return /^credito-parcelado\/novo\/erro-contratacao-indisponivel-para-esta-conta$/.test(path);
                    }
                },
                
                /////////////////////////////////////////////////////////////////////////////
                /// CREDITO PARCELADO ACTIONS ANTIGAS - 15/04/26  - NOVO UPDATE 22/04/26   //
                /// REMOVER APÓS IMPLANTAÇÃO ACTIONS NOVAS         //
                ////////////////////////////////////////////////////////////////////////////
                // Credito Parcelado
                // ----------------------------------------------------
                // Crédito Parcelado - OFERTAS DISPONÍVEIS (Conhecimento)
                // Tela: pré-aprovadas
                // Regra SPA-safe: NÃO dispara após entrar na Simulação
                // ----------------------------------------------------
                {
                    name: "emprestimo_mobile_credito_parcelado - Ofertas Disponiveis",
                    action:
                        DESC_DOMAIN.mobile
                        + PRODUTO.emprestimo.emprestimo
                        + PRODUTO.emprestimo.creditParcelado +
                        " - Ofertas disponiveis",

                    isMatch: () => {
                        try {
                            const obj = findInDataLayerRevert("screen.path");
                            const path = obj?.screen?.path;

                            if (typeof path !== "string") return false;

                            // somente a tela de pré-aprovadas
                            if (path !== "credito-parcelado/novo/pre-aprovadas") return false;

                            // bloqueia se já entrou na simulação (SPA)
                            const entrouNaSimulacao =
                                /\/como-simular/.test(window.location.pathname);

                            return !entrouNaSimulacao;
                        } catch (e) {
                            return false;
                        }
                    }
                },
                // ----------------------------------------------------
                // Crédito Parcelado - SIMULAR UPDATE 22/04/26
                // Tela: como-simular
                // Regex compatível com todas as variações reais
                // ----------------------------------------------------
                {
                    name: "emprestimo_mobile_credito_parcelado_simular",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditParcelado +
                        " - Simular",

                    isMatch: () => {
                        try {
                            // 1) DataLayer (screen.path)
                            let dlOk = false;

                            try {
                                const obj = findInDataLayerRevert("screen.path");
                                const rawPath = obj?.screen?.path;

                                if (typeof rawPath === "string") {
                                    const path = rawPath
                                        .replace(/\s*\/\s*/g, "/")
                                        .replace(/\/{2,}/g, "/")
                                        .replace(/\/+$/, "")
                                        .trim()
                                        .toLowerCase();

                                    // aceita novo-menu, customizado, card-X, null, etc.
                                    const REGEX_SIMULACAO =
                                        /^credito-parcelado\/novo\/[^\/]+\/como-simular(?:\/opcao-seguro)?$/;

                                    dlOk = REGEX_SIMULACAO.test(path);
                                }
                            } catch (e) {}

                            // 2) URL fallback (WebView)
                            const urlOk =
                                /\/bcpf_elegibilidade\/fed\/bcpf-fed-credito-parcelado\/simular-emprestimo$/
                                    .test(window.location.href);

                            // 3) Regra final
                            return dlOk || urlOk;

                        } catch (e) {
                            return false;
                        }
                    }
                },
                /* -----------------------------------------------------
                * 3) RESUMO DA PROPOSTA (CONFIRMAR DADOS)
                * CORRECAO 14/04/26 - CATALOGO ADDTOCART
                *
                * Captura por:
                *  - DataLayer (screen.path)
                *  - OU URL pathname
                *  - OU URL href (fallback Web)
                * ----------------------------------------------------- */
                {
                    name: "emprestimo_mobile_credito_parcelado_confirmar_dados",
                    // action: DESC_DOMAIN.mobile + TIPO_ATIVIDADE.emprestimo.confirmarEmprestimo + PRODUTO.emprestimo.creditoParcelado,
                    action:
                        DESC_DOMAIN.mobile
                        + PRODUTO.emprestimo.emprestimo
                        + PRODUTO.emprestimo.creditParcelado
                        + TIPO_ATIVIDADE.emprestimo.resumoPropostaEmprestimo,
                    isMatch: () => {
                        try {
                            /* =========================
                            * 1) DATA LAYER (screen.path)
                            * ========================= */
                            let dlOk = false;

                            try {
                                const obj = findInDataLayerRevert("screen.path");
                                const rawPath = obj?.screen?.path;

                                if (typeof rawPath === "string") {
                                    const path = rawPath
                                        .replace(/\s*\/\s*/g, "/")
                                        .replace(/\/{2,}/g, "/")
                                        .replace(/\/+$/, "")
                                        .trim()
                                        .toLowerCase();

                                    const reDL =
                                        /^credito-parcelado\/novo\/(com-seguro|sem-seguro)\/(novo-menu|customizado|card(?:-\d+)?)\/confirmar-dados$/;

                                    dlOk = reDL.test(path);
                                }
                            } catch (e) {
                                // falha silenciosa do DL
                            }

                            /* =========================
                            * 2) URL (fallback Web)
                            * ========================= */
                            const pathname = window.location.pathname || "";

                            const urlOk =
                                // pathname
                                /\/bcpf_elegibilidade\/fed\/bcpf-fed-credito-parcelado\/confirmar-contratacao\/?$/
                                    .test(pathname)
                                ||
                                // href completo (Web / App híbrido)
                                /\/bcpf_elegibilidade\/fed\/bcpf-fed-credito-parcelado\/confirmar-contratacao\/?$/
                                    .test(window.location.href);

                            /* =========================
                            * 3) REGRA FINAL
                            * ========================= */
                            return dlOk || urlOk;

                        } catch (e) {
                            return false;
                        }
                    },

                    // Debug temporário (pode remover depois)
                    onActionEvent: (actionEvent) => {
                        actionEvent.attributes = actionEvent.attributes || {};
                        actionEvent.attributes.page_url = window.location.href;
                        actionEvent.attributes.page_path = window.location.pathname;
                        return actionEvent;
                    },

                    // itemAction: Evergage.ItemAction.AddToCart,
                    // catalog: {
                    //     Product: {
                    //         _id: ["MI090"],
                    //         relatedCatalogObjects: {
                    //             ProdutoMacro: ["MA009"],
                    //             Necessidade: ["N002"],
                    //         }
                    //     }
                    // }
                },
                {
                    name: "emprestimo_mobile_credito_parcelado_confirmar_autorizar_debito_pagamento_parcelas",
                    // action: DESC_DOMAIN.mobile + TIPO_ATIVIDADE.emprestimo.confirmarEmprestimo + PRODUTO.emprestimo.creditoParcelado + " - Autorizar débito pagamento parcelas",
                    action: "Mobile Banking - Emprestimo - Credito Parcelado - Autorizar débito pagamento parcelas",
                    isMatch: () => /\/bcpf_elegibilidade\/fed\/bcpf-fed-credito-parcelado\/permissao-pagamento$/.test(window.location.href),
                    onActionEvent: (actionEvent) => {
                        actionEvent.attributes = actionEvent.attributes || {};
                        // URL completa para debug
                        actionEvent.attributes.page_url =
                            window.location.href;
                        // Apenas o pathname
                        actionEvent.attributes.page_path =
                            window.location.pathname;
                        return actionEvent;
                    },
                },
                /* -----------------------------------------------------
                * 5) CONTRATAÇÃO - SUCESSO
                * Purchase no catálogo.
                * Captura por:
                *  - DataLayer (screen.path)
                *  - OU URL pathname
                *  - OU URL href (fallback Web)
                * UPDATE 16/04/2026 - Inclusão de fallback por URL (pathname + href)
                * ----------------------------------------------------- */
                {
                    name: "emprestimo_mobile_credito_parcelado_sucesso",
                    // action: DESC_DOMAIN.mobile + TIPO_ATIVIDADE.emprestimo.contratarEmprestimo + PRODUTO.emprestimo.creditoParcelado,
                    action:
                        DESC_DOMAIN.mobile
                        + PRODUTO.emprestimo.emprestimo
                        + PRODUTO.emprestimo.creditParcelado
                        + " - Contratar",
                    isMatch: () => {
                        try {
                            /* =========================
                            * 1) DATA LAYER (screen.path)
                            * ========================= */
                            let dlOk = false;

                            try {
                                const obj = findInDataLayerRevert("screen.path");
                                const rawPath = obj?.screen?.path;
                                if (typeof rawPath === "string") {
                                    const path = rawPath
                                        .replace(/\s*\/\s*/g, "/")
                                        .replace(/\/{2,}/g, "/")
                                        .replace(/\/+$/, "")
                                        .trim()
                                        .toLowerCase();
                                    const reDL =
                                        /^credito-parcelado\/novo\/(com-seguro|sem-seguro)\/(novo-menu|customizado|card(?:-\d+)?)\/sucesso$/;
                                    dlOk = reDL.test(path);
                                }
                            } catch (e) {
                                // falha silenciosa do DL
                            }

                            /* =========================
                            * 2) URL (fallback Web)
                            * ========================= */
                            const pathname = window.location.pathname || "";
                            const urlOk =
                                // pathname
                                /\/bcpf_elegibilidade\/fed\/bcpf-fed-credito-parcelado\/conclusao-contratacao\/?$/
                                    .test(pathname)
                                ||
                                // href completo
                                /\/bcpf_elegibilidade\/fed\/bcpf-fed-credito-parcelado\/conclusao-contratacao\/?$/
                                    .test(window.location.href);

                            /* =========================
                            * 3) REGRA FINAL
                            * ========================= */
                            return dlOk || urlOk;
                        } catch (e) {
                            return false;
                        }
                    },

                    // itemAction: Evergage.ItemAction.Purchase,
                    // catalog: {
                    //     Product: {
                    //         orderId: generateRandomOrderIdIB(),
                    //         lineItems: {
                    //             _id: ["MI090"],
                    //             price: [1],
                    //             quantity: [1]
                    //         },
