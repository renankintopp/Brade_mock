                                value === "consignado-refinanciamento/inss/com-oferta-seguro/analise-dataprev" ||
                                value === "consignado-refinanciamento/inss/sem-oferta-seguro/analise-dataprev/meu-inss" ||
                                value === "consignado-refinanciamento/inss/com-oferta-seguro/analise-dataprev/meu-inss";
                            if (!match) return false;
                            return true;
                        } catch {
                            return false;
                        }
