                // CARTEIRA DIGITAL UPDATE 25/05/26
                {
                    name: "carteira_digital_mobile_conhecimento",
                    isMatch: () => {
                        try {
                            ////////////////////////////////////////////////////
                            // VALIDA PATH
                            ////////////////////////////////////////////////////
                            var path = window.location && window.location.pathname;
                            if (!path) return false;
                            if (!/\/bcpf_carteira_digital\/bcpf_carteira_digital_1_0/i.test(path)) {
                                return false;
                            }
                            ////////////////////////////////////////////////////
                            // VALIDA ELEMENTO
                            ////////////////////////////////////////////////////
                            var el = Evergage.cashDom(".header__title");
                            if (!el || !el[0] || !el[0].innerText) {
                                return false;
                            }
                            ////////////////////////////////////////////////////
                            // MATCH FINAL
                            ////////////////////////////////////////////////////
                            if (el[0].innerText === "Google Pay") {
                                Evergage.sendEvent({
                                    action: DESC_DOMAIN.mobile + TIPO_ATIVIDADE.cartoes.conhecimentoCartoes + PRODUTO.cartoes.carteiraDigital + " - Google Pay",
                                });
                                return true; // IMPORTANTE
                            }
                            return false;
                        } catch (e) {
                            return false;
                        }
                    }
                },
                
