                //////////////////////////////////
                // Consignado Privado E-SOCIAL
                //////////////////////////////////

                // ----------------------------------------------------
                // ----------------------------------------------------
                // Consignado Privado e-social - ENTRADA JORNADA
                // Estratégia:
                // 1. URL específica
                // 2. Grava contexto da jornada
                // Objetivo:
                // garantir identificação do e-social nas próximas etapas
                // UPDATE: 01/07/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - Emprestimo - Credito Consignado Privado - e-social - Entrada Jornada",
                    isMatch: () => {
                        try {
                            var path = window.location.pathname?.toLowerCase();
                            if (!path) return false;
                            if (
                                path.includes("/e-social/boas-vindas") ||
                                path.includes("/e-social/resumo-oferta")
                            ) {
                                sessionStorage.setItem("journey_consignado", "e-social");
                                return false;
                            }
                            return false;
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // Consignado Privado e-social - CONHECIMENTO
                // Base: Revert + match exato + fallback URL controlado
                // UPDATE: 26/05/2026 - proteção contra vazamento (contexto + DL)
                // ----------------------------------------------------
                {
                    name: "mobile_credito_consignado - Privado - e-social - Conhecimento",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivadoeSocial +
                        " - Conhecimento",

                    isMatch: () => {
                        try {
                            const obj = findInDataLayerRevert("ep_padrao.screen_name");
                            const value = obj?.ep_padrao?.screen_name;

                            const dlMatch =
                                value === "consignado-novo/privado/e-social/onboarding" ||
                                value === "consignado-refinanciamento/privado/e-social/onboarding";

                            const urlMatch =
                                /\/brairootmbpf\/e-social\/boas-vindas/
                                    .test(window.location.pathname);

                            const match = dlMatch || urlMatch;

                            if (!match) return false;
                            return true;
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // Consignado Privado e-social - SIMULAÇÃO
                // Estratégia:
                // 1. URL (etapa)
                // 2. Session (validação)
                // 3. DataLayer (principal)
                // 4. Bloqueios explícitos
                // Objetivo:
                // evitar vazamento sem perder cobertura
                // UPDATE: 02/07/2026
                // ----------------------------------------------------
                {
                    name: "mobile_credito_consignado - Privado - e-social - Simular",
                
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivadoeSocial +
                        " - Simular",
                
                    isMatch: () => {
                        try {
                
                            ////////////////////////////////////////////////////
                            // URL
                            ////////////////////////////////////////////////////
                            var path = window.location.pathname?.toLowerCase();
                
                            if (
                                !path ||
                                (
                                    !path.includes("/simulacao") &&
                                    !path.includes("/resumo-oferta")
                                )
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // SESSION
                            ////////////////////////////////////////////////////
                            var isESocial =
                                sessionStorage.getItem("journey_consignado") === "e-social";
                
                            if (!isESocial) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // DL SAFE
                            ////////////////////////////////////////////////////
                            var screen = getLastRelevantScreen(function (s) {
                                return (
                                    s.includes("consignado-novo/privado") &&
                                    s.includes("e-social") &&
                                    s.includes("simulacao")
                                );
                            });
                
                            if (!screen) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // BLOQUEIOS
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes("/inss/") ||
                                screen.includes("publico") ||
                                screen.includes("refinanciamento")
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // MATCH FINAL
                            ////////////////////////////////////////////////////
                            return true;
                
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // Consignado Privado e-social - RESUMO PROPOSTA
                // Estratégia:
                // 1. URL exata (etapa)
                // 2. Session (jornada)
                // 3. DL legado (produto)
                // 4. DL novo (produto)
                // 5. Bloqueios explícitos
                // Objetivo:
                // garantir contexto de produto e evitar vazamento
                // UPDATE: 07/07/2026
                // ----------------------------------------------------
                {
                    name: "mobile_credito_consignado - Privado - e-social - Resumo Proposta",
                
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivadoeSocial +
                        TIPO_ATIVIDADE.emprestimo.resumoPropostaEmprestimo,
                
                    isMatch: () => {
                        try {
                
                            ////////////////////////////////////////////////////
                            // URL - ETAPA
                            ////////////////////////////////////////////////////
                            var path = window.location.pathname?.toLowerCase();
                
                            if (
                                !path ||
                                path !== "/brairootmbpf/proposta"
                            ) {
                                return false;
                            }
                
                            // ////////////////////////////////////////////////////
                            // // SESSION - JORNADA
                            // ////////////////////////////////////////////////////
                            // var isESocial =
                            //     sessionStorage.getItem("journey_consignado") === "e-social";
                
                            // if (!isESocial) {
                            //     return false;
                            // }
                
                            ////////////////////////////////////////////////////
                            // DL LEGADO
                            ////////////////////////////////////////////////////
                            var legacy =
                                findInDataLayerRevert("ep_padrao.screen_name")
                                    ?.ep_padrao?.screen_name
                                    ?.toLowerCase();
                
                            ////////////////////////////////////////////////////
                            // DL NOVO
                            ////////////////////////////////////////////////////
                            var modern =
                                findInDataLayerRevert("screen.path")
                                    ?.screen?.path
                                    ?.toLowerCase();
                
                            ////////////////////////////////////////////////////
                            // BLOQUEIOS
                            ////////////////////////////////////////////////////
                            var screen = legacy || modern || "";
                
                            if (
                                screen &&
                                (
                                    screen.includes("/inss/") ||
                                    screen.includes("publico") ||
                                    screen.includes("refinanciamento")
                                )
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // MATCH DL
                            ////////////////////////////////////////////////////
                            var matchDL =
                                (
                                    legacy &&
                                    legacy.includes("e-social") &&
                                    (
                                        legacy.includes("confirmacao") ||
                                        legacy.includes("resumo")
                                    )
                                )
                                ||
                                (
                                    modern &&
                                    (
                                        modern.includes("confirmacao/e-social") ||
                                        modern.includes("resumo-simulacao/e-social")
                                    )
                                );
                
                            ////////////////////////////////////////////////////
                            // MATCH FINAL
                            ////////////////////////////////////////////////////
                            return !!matchDL;
                
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // Consignado Privado e-social - CONTRATAÇÃO
                // Estratégia:
                // 1. URL exata (etapa)
                // 2. SessionStorage (BE)
                // 3. SessionStorage (Sitemap)
                // 4. DataLayer Smart
                // 5. Bloqueios explícitos
                //
                // Objetivo:
                // Garantir captura da jornada e-social com
                // múltiplas evidências e evitar vazamento.
                //
                // UPDATE: 05/08/2026
                // ----------------------------------------------------
                {
                    name: "mobile_credito_consignado_privado - e-social - Contratar",

                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivadoeSocial +
                        " - Contratar",

                    isMatch: () => {
                        try {

                            ////////////////////////////////////////////////////
                            // URL
                            ////////////////////////////////////////////////////
                            var path = window.location.pathname?.toLowerCase();

                            if (
                                !path ||
                                path !== "/brairootmbpf/formalizacao"
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // SESSIONS
                            ////////////////////////////////////////////////////
                            var isPrivado =
                                sessionStorage.getItem("consignado-privado") === "true";

                            var isESocialJourney =
                                sessionStorage.getItem("journey_consignado") === "e-social";

                            ////////////////////////////////////////////////////
                            // DATALAYER
                            ////////////////////////////////////////////////////
                            var screen = getDataLayerValueSmart(
                                window.dataLayer,
                                "Screen_Data",
                                "ep_padrao.screen_name",
                                function(value) {

                                    if (typeof value !== "string") {
                                        return false;
                                    }

                                    value = value.toLowerCase();

                                    ////////////////////////////////////////////////////
                                    // BLOQUEIOS
                                    ////////////////////////////////////////////////////
                                    if (
                                        value.includes("/inss/") ||
                                        value.includes("publico") ||
                                        value.includes("refinanciamento")
                                    ) {
                                        return false;
                                    }

                                    ////////////////////////////////////////////////////
                                    // E-SOCIAL
                                    ////////////////////////////////////////////////////
                                    return (
                                        value.includes("e-social") &&
                                        (
                                            value.includes("aprovado") ||
                                            value.includes("modal-avaliador")
                                        )
                                    );
                                }
                            );

                            ////////////////////////////////////////////////////
                            // GARANTIA DE E-SOCIAL
                            ////////////////////////////////////////////////////
                            var matchDL = !!screen;

                            ////////////////////////////////////////////////////
                            // EVIDÊNCIAS DE CONTEXTO
                            ////////////////////////////////////////////////////
                            var hasJourneyEvidence =
                                isPrivado ||
                                isESocialJourney ||
                                matchDL;

                            ////////////////////////////////////////////////////
                            // MATCH FINAL
                            ////////////////////////////////////////////////////
                            return (
                                hasJourneyEvidence &&
                                matchDL
                            );

                        } catch (e) {
                            return false;
                        }
                    }
                },
                
                // ----------------------------------------------------
                // Consignado Privado e-social - EM ANALISE
                // UPDATE: 26/05/2026 - proteção DL + contexto
                // ----------------------------------------------------
                {
                    name: "mobile_credito_consignado_privado e-social - Contratar - Em Analise",

                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoPrivadoeSocial +
                        " - Em Analise",

                    isMatch: () => {
                        try {

                            const screenName = findInDataLayerRevert("ep_padrao.screen_name")?.ep_padrao?.screen_name;
                            if (typeof screenName !== "string") return false;

                            const normalized = screenName.replace(/\/+$/, "").trim();

                            const EM_ANALISE_ESOCIAL_PATHS = [
                                "consignado-novo/privado/em-analise/e-social",
                                "consignado-refinanciamento/privado/em-analise/e-social",
                                "consignado-novo/privado/com-oferta-seguro/em-analise/e-social",
                                "consignado-novo/privado/sem-oferta-seguro/em-analise/e-social",
                                "consignado-novo/privado/aceite-re-oferta/em-analise/e-social",
                                "consignado-novo/privado/sem-aceite-re-oferta/em-analise/e-social"
                            ];

                            if (!EM_ANALISE_ESOCIAL_PATHS.includes(normalized)) return false;

                            // if (isBlockedConsignadoContext()) return false;

                            return true;

                        } catch {
                            return false;
                        }
                    }
                },
                
                ////////////////
                // INSS       //
                ////////////////
                // ----------------------------------------------------
                // INSS (Meu INSS) - SIMULAÇÃO
                // Baseado em ep_padrao.screen_name OU fallback por URL
                // UPDATE 01/06/2026 - Ajuste de rotas (remoção refin + inclusão meu-inss)
                // Incrementa: ViewItem
                // ----------------------------------------------------
                {
                    name: "Mobile - credito_consignado - INSS - Simular",

                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSS +
                        " - Simular",
                        
                    isMatch: () => {
                        try {

                            const obj = findInDataLayerRevert("ep_padrao.screen_name");
                            const screenName = obj?.ep_padrao?.screen_name;
                            if (typeof screenName !== "string") return false;

                            const normalized = screenName.replace(/\/+$/, "").trim();

                            const SIMULACAO_INSS_PATHS = [
                                        // GA FULL atual
                                        "consignado-novo/inss/sem-oferta-seguro/simulacao",

                                        // NOVOS (MEU INSS)
                                        // "consignado-novo/inss/proposta/meu-inss",
                                        "consignado-novo/inss/sem-oferta-seguro/simulacao/meu-inss",
                                        "consignado-novo/inss/modal-re-oferta/sem-oferta-seguro/simulacao/meu-inss"
                            ];
                            if (!SIMULACAO_INSS_PATHS.includes(normalized)) return false;
                            // if (isBlockedConsignadoContext()) return false;
                            return true;
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // INSS (Meu INSS) - RESUMO DA PROPOSTA
                // Estratégia:
                // 1. URL obrigatória
                // 2. DataLayer atual (screen atual)
                // 3. Bloqueios explícitos
                //
                // Objetivo:
                // Evitar conflito com Refin INSS,
                // Privado e outras jornadas.
                //
                // UPDATE: 06/08/2026
                // ----------------------------------------------------
                {
                    name: "Mobile_credito_consignado_INSS_Contratar_Resumo_da_Proposta",

                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSS +
                        TIPO_ATIVIDADE.emprestimo.resumoPropostaEmprestimo,

                    isMatch: () => {
                        try {

                            ////////////////////////////////////////////////////
                            // URL OBRIGATÓRIA
                            ////////////////////////////////////////////////////
                            var path =
                                (window.location.pathname || "")
                                    .toLowerCase();

                            if (
                                path !== "/brairootmbpf/proposta"
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // SCREEN ATUAL
                            ////////////////////////////////////////////////////
                            var screen = getScreenNameSafe();

                            if (!screen) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIOS
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes("privado") ||
                                screen.includes("refinanciamento") ||
                                screen.includes("publico")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // LISTA FECHADA
                            ////////////////////////////////////////////////////
                            return (
                                screen === "consignado-novo/inss/sem-oferta-seguro/confirmacao" ||
                                screen === "consignado-novo/inss/sem-oferta-seguro/confirmacao/nova-oferta/meu-inss" ||
                                screen === "consignado-novo/inss/sem-oferta-seguro/confirmacao/valor-escolhido/meu-inss" ||
                                screen === "consignado-novo/inss/confirmacao/meu-inss"
                            );

                        } catch (e) {
                            return false;
                        }
                    }
                },

// ----------------------------------------------------
                // INSS - CONTRATAÇÃO APROVADO
                // Estratégia:
                // 1. URL obrigatória
                // 2. DataLayer como fonte principal
                // 3. SessionStorage do BE como evidência complementar
                // 4. Controle de duplicidade
                // 5. Bloqueios explícitos de outros produtos
                //
                // Objetivo:
                // Aumentar cobertura da contratação INSS sem
                // depender exclusivamente da chave do BE,
                // mantendo proteção contra vazamentos.
                //
                // UPDATE: 07/08/2026
                // ----------------------------------------------------
                {
                    name: "mobile_credito_consignado_inss - Contratar",
                
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSS +
                        " - Contratar",
                
                    isMatch: () => {
                        try {
                
                            ////////////////////////////////////////////////////
                            // URL OBRIGATÓRIA
                            ////////////////////////////////////////////////////
                            var path =
                                (window.location.pathname || "")
                                    .toLowerCase();
                
                            if (
                                path !== "/brairootmbpf/formalizacao"
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // CONTROLE DE DUPLICIDADE
                            ////////////////////////////////////////////////////
                            if (
                                sessionStorage.getItem(
                                    "inss_contratacao_disparada"
                                ) === "true"
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // EVIDÊNCIA DO BE (NÃO OBRIGATÓRIA)
                            ////////////////////////////////////////////////////
                            var hasSessionEvidence =
                                sessionStorage.getItem(
                                    "consignado-inss"
                                ) === "true";
                
                            ////////////////////////////////////////////////////
                            // SCREEN ATUAL
                            ////////////////////////////////////////////////////
                            var screen = getScreenNameSafe();
                
                            if (
                                !screen ||
                                typeof screen !== "string"
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // BLOQUEIOS DE OUTROS PRODUTOS
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes("privado") ||
                                screen.includes("publico") ||
                                screen.includes("e-social") ||
                                screen.includes("refinanciamento")
                            ) {
                                return false;
                            }
                
                            ////////////////////////////////////////////////////
                            // CONTRATAÇÃO INSS
                            ////////////////////////////////////////////////////
                            var matchDL =
                                screen.includes("consignado-novo/inss") &&
                                (
                                    screen.includes("aprovado") ||
                                    screen.includes("modal-avaliador")
                                );
                
                            ////////////////////////////////////////////////////
                            // GARANTIA DE CONTEXTO
                            ////////////////////////////////////////////////////
                            var hasINSSContext =
                                hasSessionEvidence ||
                                screen.includes("consignado-novo/inss");
                
                            ////////////////////////////////////////////////////
                            // MATCH FINAL
                            ////////////////////////////////////////////////////
                            if (
                                matchDL &&
                                hasINSSContext
                            ) {
                
                                sessionStorage.setItem(
                                    "inss_contratacao_disparada",
                                    "true"
                                );
                
                                return true;
                            }
                
                            return false;
                
                        } catch (e) {
                            return false;
                        }
                    }
                },

                ////////////////////////////////////////
                // INSS – EXCEÇÕES / ERROS
                ////////////////////////////////////////

                // ----------------------------------------------------
                // INSS (Meu INSS) - EM ANALISE DATAPREV
                // UPDATE 01/06/2026 - Ajuste de rotas (normalização DL + inclusão meu-inss)
                // ----------------------------------------------------
                {
                    name: "Mobile - credito_consignado - INSS - Em Analise Dataprev",

                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSS +
                        " - Em Analise Dataprev",

                    isMatch: () => {
                        try {

                            ////////////////////////////////////////////////////
                            // 1) DATA LAYER (PRINCIPAL)
                            ////////////////////////////////////////////////////
                            var dlOk = false;

                            try {
                                var obj = findInDataLayerRevert("ep_padrao.screen_name");

                                var screenName =
                                    (obj && obj.ep_padrao && obj.ep_padrao.screen_name)
                                        ? obj.ep_padrao.screen_name
                                        : "";

                                if (typeof screenName === "string" && screenName) {

                                    var normalized = screenName
                                        .replace(/\/{2,}/g, "/") // corrige dupla barra
                                        .replace(/\/+$/, "")
                                        .trim()
                                        .toLowerCase();

                                    ////////////////////////////////////////////////////
                                    // LISTA FECHADA (GA FULL + MEU INSS)
                                    ////////////////////////////////////////////////////
                                    var EM_ANALISE_INSS_PATHS = [

                                        // GA FULL histórico
                                        "consignado-novo/inss/sem-oferta-seguro/analise-dataprev",

                                        // NOVOS (DOC - MEU INSS)
                                        "consignado-novo/inss/analise-dataprev/nova-oferta/meu-inss",
                                        "consignado-novo/inss/analise-dataprev/valor-escolhido/meu-inss",

                                        // fallback genérico
                                        "consignado-novo/inss/analise-dataprev/meu-inss"

                                    ];

                                    dlOk = EM_ANALISE_INSS_PATHS.includes(normalized);
                                }

                            } catch (e) {
                                // fail silent
                            }

                            return dlOk;

                        } catch (e) {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // INSS (Meu INSS) - ERRO
                // Valor solicitado não disponível
                // UPDATE 01/06/2026 - Ajuste de rotas (normalização DL + inclusão meu-inss)
                // ----------------------------------------------------
                {
                    name: "Mobile - credito_consignado - INSS - Erro - Valor solicitado nao disponivel",

                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSS +
                        " - Erro - valor solicitado nao disponivel",

                    isMatch: () => {
                        try {

                            ////////////////////////////////////////////////////
                            // 1) DATA LAYER (PRINCIPAL)
                            ////////////////////////////////////////////////////
                            var dlOk = false;

                            try {
                                var obj = findInDataLayerRevert("ep_padrao.screen_name");

                                var screenName =
                                    (obj && obj.ep_padrao && obj.ep_padrao.screen_name)
                                        ? obj.ep_padrao.screen_name
                                        : "";

                                if (typeof screenName === "string" && screenName) {

                                    var normalized = screenName
                                        .replace(/\/{2,}/g, "/") // corrige dupla barra
                                        .replace(/\/+$/, "")
                                        .trim()
                                        .toLowerCase();

                                    ////////////////////////////////////////////////////
                                    // LISTA FECHADA (GA FULL + MEU INSS)
                                    ////////////////////////////////////////////////////
                                    var ERRO_INSS_PATHS = [

                                        // GA FULL
                                        "consignado-novo/inss/erro/valor-solicitado-nao-disponivel",

                                        // NOVO (DOC - MEU INSS)
                                        "consignado-novo/inss/erro/valor-solicitado-nao-disponivel/meu-inss"

                                    ];

                                    dlOk = ERRO_INSS_PATHS.includes(normalized);
                                }

                            } catch (e) {
                                // fail silent
                            }

                            return dlOk;

                        } catch (e) {
                            return false;
                        }
                    }
                },
 
                ///////////////////////////////////////////////////////////////////////////////
                // CONSIGNADO – REFINANCIAMENTO INSS (MEU INSS)
                // UPDATE FINAL: 26/05/2026
                //
                // Ajustes realizados:
                // - Remoção de Smart (evita vazamento por histórico)
                // - Uso de Revert (estado mais recente)
                // - Inclusão de proteção de contexto (anti-vazamento SPA)
                // - Mantido runPageTypeOnce para controle de disparo
                ///////////////////////////////////////////////////////////////////////////////

                // ----------------------------------------------------
                // Refinanciamento INSS - CONTEXTO JORNADA
                // Estratégia:
                // 1. DataLayer
                // 2. Marca contexto da jornada
                //
                // Objetivo:
                // Persistir jornada para telas genéricas
                //
                // UPDATE: 10/07/2026
                // ----------------------------------------------------
                {
                    name: "Refin INSS - Entrada Jornada",
                    isMatch: () => {
                        try {
                            var screen = getScreenNameSafe();
                            if (
                                screen &&
                                screen.includes("consignado-refinanciamento/inss")
                            ) {
                                if (
                                    sessionStorage.getItem("journey_consignado")
                                    !== "refin-inss"
                                ) {
                                    sessionStorage.setItem(
                                        "journey_consignado",
                                        "refin-inss"
                                    );
                                    sessionStorage.setItem(
                                        "journey_timestamp",
                                        Date.now().toString()
                                    );
                                }
                            }
                            return false;
                        } catch {
                            return false;
                        }
                    }
                },

                ////////////////////////////////////////////////////
                // 1) CONHECIMENTO
                ////////////////////////////////////////////////////
                {
                    name: "Mobile - credito_consignado - Refinanciamento INSS - Conhecimento",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSSRefin +
                        " - Conhecimento",
                    isMatch: () => {
                        try {
                            const value = findInDataLayerRevert("ep_padrao.screen_name")?.ep_padrao?.screen_name;
                            const match =
                                value === "consignado-refinanciamento/inss/meu-inss" ||
                                value === "consignado-refinanciamento/inss/onboarding" ||
                                value === "consignado-refinanciamento/inss/onboarding/meu-inss" ||
                                value === "consignado-refinanciamento/inss/ofertas";
                            if (!match) return false;
                            return true;
                        } catch {
                            return false;
                        }
                    }
                },

                ////////////////////////////////////////////////////
                // 2) SIMULAÇÃO
                ////////////////////////////////////////////////////
                {
                    name: "Mobile - credito_consignado - Refinanciamento INSS - Simular",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSSRefin +
                        " - Simular",
                    isMatch: () => {
                        try {
                            const value = findInDataLayerRevert("ep_padrao.screen_name")?.ep_padrao?.screen_name;
                            const match =
                                value === "consignado-refinanciamento/inss/dados-simulacao" ||
                                value === "consignado-refinanciamento/inss/dados-simulacao/meu-inss" ||
                                value === "consignado-refinanciamento/inss/sem-oferta-seguro/simulacao" ||
                                value === "consignado-refinanciamento/inss/com-oferta-seguro/simulacao" ||
                                value === "consignado-refinanciamento/inss/sem-oferta-seguro/simulacao/meu-inss" ||
                                value === "consignado-refinanciamento/inss/com-oferta-seguro/simulacao/meu-inss";
                            if (!match) return false;
                            return true;
                        } catch {
                            return false;
                        }
                    }
                },

                // ----------------------------------------------------
                // Refinanciamento INSS - RESUMO DA PROPOSTA
                //
                // Estratégia:
                // 1. URL obrigatória
                // 2. Último Screen_Data (estado atual)
                // 3. Bloqueios explícitos de outras jornadas
                //
                // Objetivo:
                // Evitar vazamento para Cartões,
                // Privado, Público, e-Social,
                // INSS normal e telas posteriores.
                //
                // UPDATE: 06/08/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - credito_consignado - Refinanciamento INSS - Resumo da Proposta",

                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSSRefin +
                        TIPO_ATIVIDADE.emprestimo.resumoPropostaEmprestimo,

                    isMatch: () => {
                        try {

                            ////////////////////////////////////////////////////
                            // URL OBRIGATÓRIA
                            ////////////////////////////////////////////////////
                            var path =
                                (window.location.pathname || "")
                                    .toLowerCase();

                            if (
                                path !== "/brairootmbpf/proposta"
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO BIOMETRIA
                            ////////////////////////////////////////////////////
                            if (
                                path.includes("/biometria/")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO CARTÕES
                            ////////////////////////////////////////////////////
                            if (
                                window.location.href.includes("cartoes") ||
                                window.location.href.includes("cartao") ||
                                window.location.href.includes("bcpf-fed-aquisicao-cartoes")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO PRIVADO
                            ////////////////////////////////////////////////////
                            if (
                                path.includes("/privado/")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // SCREEN ATUAL
                            ////////////////////////////////////////////////////
                            var obj =
                                findInDataLayerRevert(
                                    "ep_padrao.screen_name"
                                );

                            var screen =
                                obj?.ep_padrao?.screen_name;

                            if (
                                typeof screen !== "string"
                            ) {
                                return false;
                            }

                            screen = screen.toLowerCase();

                            ////////////////////////////////////////////////////
                            // BLOQUEIO INSS NORMAL
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes(
                                    "consignado-novo/inss"
                                )
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO PRIVADO
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes("privado")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO PÚBLICO
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes("publico")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO E-SOCIAL
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes("e-social")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // MATCH REFIN INSS
                            ////////////////////////////////////////////////////
                            return (
                                screen.includes(
                                    "consignado-refinanciamento/inss"
                                ) &&
                                screen.includes(
                                    "confirmacao"
                                )
                            );

                        } catch (e) {
                            return false;
                        }
                    }
                },
                
                // ----------------------------------------------------
                // REFIN INSS - CONTRATAÇÃO
                // Estratégia:
                // 1. Bloqueio explícito de telas indevidas
                // 2. URL utilizada apenas como proteção adicional
                // 3. Match obrigatório pelo DataLayer
                // 4. Bloqueios explícitos de outros produtos
                //
                // Objetivo:
                // Garantir que a contratação seja identificada
                // exclusivamente pela jornada Refinanciamento INSS,
                // evitando vazamento para INSS, Privado,
                // Público, e-Social e Cartões.
                //
                // UPDATE: 07/08/2026
                // ----------------------------------------------------
                {
                    name: "Mobile - credito_consignado - Refinanciamento INSS - Contratar",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSSRefin +
                        " - Contratar",

                    isMatch: () => {
                        try {
                            ////////////////////////////////////////////////////
                            // URL ATUAL
                            ////////////////////////////////////////////////////
                            var path =
                                (window.location.pathname || "")
                                    .toLowerCase();
                            ////////////////////////////////////////////////////
                            // BLOQUEIO DE BIOMETRIA
                            ////////////////////////////////////////////////////
                            if (
                                path.includes("/biometria/")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO DE CARTÕES
                            ////////////////////////////////////////////////////
                            if (
                                window.location.href.includes("cartoes") ||
                                window.location.href.includes("cartao") ||
                                window.location.href.includes("bcpf-fed-aquisicao-cartoes")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // BLOQUEIO DE PRIVADO
                            ////////////////////////////////////////////////////
                            if (
                                path.includes("/privado/")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // FORMALIZAÇÃO
                            // Utilizada apenas como proteção adicional.
                            // NÃO define o match.
                            ////////////////////////////////////////////////////
                            if (
                                path !== "/brairootmbpf/formalizacao"
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // ÚLTIMO SCREEN REAL
                            ////////////////////////////////////////////////////
                            var obj =
                                findInDataLayerRevert(
                                    "ep_padrao.screen_name"
                                );
                            var screen =
                                obj?.ep_padrao?.screen_name;
                            if (
                                typeof screen !== "string"
                            ) {
                                return false;
                            }
                            screen = screen.toLowerCase();

                            ////////////////////////////////////////////////////
                            // BLOQUEIOS DE OUTROS PRODUTOS
                            ////////////////////////////////////////////////////
                            if (
                                screen.includes("consignado-novo/inss") ||
                                screen.includes("consignado-novo/privado") ||
                                screen.includes("publico") ||
                                screen.includes("e-social")
                            ) {
                                return false;
                            }

                            ////////////////////////////////////////////////////
                            // MATCH REFIN INSS
                            ////////////////////////////////////////////////////
                            return (
                                screen.includes(
                                    "consignado-refinanciamento/inss"
                                ) &&
                                (
                                    screen.includes("confirmacao") ||
                                    screen.includes("aprovado") ||
                                    screen.includes("modal-avaliador")
                                )
                            );
                        } catch (e) {
                            return false;
                        }
                    }
                },
               
                ////////////////////////////////////////////////////
                // 5) EM ANALISE DATAPREV
                ////////////////////////////////////////////////////
                {
                    name: "Mobile - credito_consignado - Refinanciamento INSS - Em Analise Dataprev",
                    action:
                        DESC_DOMAIN.mobile +
                        PRODUTO.emprestimo.emprestimo +
                        PRODUTO.emprestimo.creditoConsignadoINSSRefin +
                        " - Em Analise Dataprev",
                    isMatch: () => {
