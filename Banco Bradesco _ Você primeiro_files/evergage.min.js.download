                //                 elementoRetornado?.ep_padrao?.screen_name === "consignado-novo/privado/com-oferta-seguro/modal-avaliador" ||
                //                 elementoRetornado?.ep_padrao?.screen_name === "consignado-novo/privado/sem-oferta-seguro/modal-avaliador" ||
                //                 elementoRetornado?.ep_padrao?.screen_name === "consignado-novo/privado/com-oferta-seguro/aprovado" ||
                //                 elementoRetornado?.ep_padrao?.screen_name === "consignado-novo/privado/sem-oferta-seguro/aprovado"                                
                //             );
                //         } catch (e) {
                //             return false;
                //         }
                //     },
                // },

                // ----------------------------------------------------
                // Consignado Privado - EM ANALISE
                // Estratégia: Revert + match exato + bloqueio contexto
