                    //    Evergage.cashDom("p.legCenter")[0]?.innerText == "Neste momento, não temos produtos disponíveis. Por favor, vá até sua agência.",
                    itemAction: Evergage.ItemAction.ViewItem,
                    catalog: {
                        Product: {
                            _id: "MI122",
                            relatedCatalogObjects: {
                                ProdutoMacro: ["MA019"],
                                Necessidade: ["N010"],
                            }
                        }
                    }
                },

                // Cartoes - Interesse (novo + legado)
                // Suporte ao novo padrão (screen.path) e ao legado (ep_padrao.screen_name)
                // Com bloqueio explícito das etapas seguintes da jornada
                // UPDATE: 10/06/2026
                {
                    name: "cartoes_mobile_interesse - novo",
                    action:
                        DESC_DOMAIN.mobile +
                        "Cartões - " +
                        TIPO_ATIVIDADE.cartoes.interesseCartoes +
                        " - novo",
                    isMatch: () => {
                        try {
                            ////////////////////////////////////////////////////
                            // 1. CONTEXTO URL (ANTI VAZAMENTO)
                            ////////////////////////////////////////////////////
                            var pathUrl = window.location && window.location.pathname;
                            if (typeof pathUrl !== "string") return false;
                            pathUrl = pathUrl.toLowerCase();
                            ////////////////////////////////////////////////////
                            // BLOQUEIO DAS OUTRAS ETAPAS
                            ////////////////////////////////////////////////////
                            if (
                                pathUrl.includes("/configurar-cartao") ||
                                pathUrl.includes("/complete-dados") ||
                                pathUrl.includes("/resumo")
                            ) {
                                return false;
                            }
                            ////////////////////////////////////////////////////
                            // PERMITIDO SOMENTE NA TELA DE ESCOLHA
                            ////////////////////////////////////////////////////
                            var isTelaInteresse =
                                pathUrl.includes("/escolha-cartao");
                            if (!isTelaInteresse) return false;
                            ////////////////////////////////////////////////////
                            // 2. NOVO PADRÃO (screen.path)
                            ////////////////////////////////////////////////////
                            var objScreen = findInDataLayerRevert("screen");
                            var screenPath =
                                (objScreen && objScreen.screen && objScreen.screen.path)
                                    ? objScreen.screen.path.toLowerCase()
                                    : "";
                            if (screenPath === "cartao-credito/escolha-seu-novo-cartao") {
                                return true;
                            }
                            ////////////////////////////////////////////////////
                            // 3. LEGADO (ep_padrao.screen_name)
                            ////////////////////////////////////////////////////
                            var objPadrao = findInDataLayerRevert("ep_padrao");
                            var screenName =
                                (objPadrao && objPadrao.ep_padrao && objPadrao.ep_padrao.screen_name)
                                    ? objPadrao.ep_padrao.screen_name
                                    : "";
                            if (typeof screenName === "string") {
                                screenName = screenName
                                    .replace(/\/+$/, "")
                                    .toLowerCase();
                                if (
                                    screenName === "apppf/cartoes/solicitacao_cartao/carrossel_cartao"
                                ) {
                                    return true;
                                }
                            }
                            ////////////////////////////////////////////////////
                            // 4. DEFAULT
                            ////////////////////////////////////////////////////
                            return false;
                        } catch (e) {
                            return false;
                        }
                    },
                    itemAction: Evergage.ItemAction.ViewItem,
                    catalog: {
                        Product: {
                            _id: "MI122",
                            relatedCatalogObjects: {
                                ProdutoMacro: ["MA019"],
                                Necessidade: ["N010"],
                            }
                        }
