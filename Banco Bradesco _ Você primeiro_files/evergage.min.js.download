                            // =========================
                            const values = getDataLayerValuesBySourcePriority(window.dataLayer);
                
                            const dlMatch = values.some(v => PATHS.includes(v));
                
                            // =========================
                            // 3) Fallback URL
                            // =========================
                            const urlMatch =
                                /\/bcpf_renegociacao_divida\/bcpf_renegociacao_1_0$/
                                    .test(window.location.pathname);
                
                            // =========================
                            // 4) Regra final
                            // =========================
